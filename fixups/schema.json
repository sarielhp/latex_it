{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "arxiv_id", "source_sha256", "summary", "files", "proposed_repair"],
  "properties": {
    "schema_version": {"const": 1},
    "arxiv_id": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+v[0-9]+$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary": {"type": "string", "minLength": 1},
    "files": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "proposed_repair": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
