#!/usr/bin/env ruby
# frozen_string_literal: true

# ==============================================================================
# Unified LaTeX Builder (latex_it / l)
#
# Robust, high-performance LaTeX compilation manager with:
# - Automatic main file detection (.mainfile or directory scan)
# - Isolated junk directory output (`junk/`)
# - Multi-engine support (xelatex [default], lualatex, pdflatex)
# - BibTeX and Biber bibliography generation
# - Single-pass compilation mode (-u)
# - PDF text diff-based update mode (-d / --diff)
# - Detailed warning and error log analysis
# - Clean pre-builds and timing diagnostics
# ==============================================================================

require 'digest'
require 'fileutils'
require 'json'
require 'open3'
require 'optparse'
require 'shellwords'
require 'tmpdir'

require_relative 'lib/latex_it/version'
require_relative 'lib/latex_it/color'
require_relative 'lib/latex_it/compatibility'
require_relative 'lib/latex_it/config'
require_relative 'lib/latex_it/utils'
require_relative 'lib/latex_it/brace_checker'
require_relative 'lib/latex_it/flattener'
require_relative 'lib/latex_it/meta_extractor'
require_relative 'lib/latex_it/error_catalog'
require_relative 'lib/latex_it/diagnostics'
require_relative 'lib/latex_it/builder'
require_relative 'lib/latex_it/packager'
require_relative 'lib/latex_it/arxiv'

module LatexCLI
  def self.run(argv = ARGV, prog_name = File.basename($PROGRAM_NAME))
    return if early_personality_dispatch(argv, prog_name)

    extra_cli_files = extract_extra_cli_files(argv)
    cfg = LaTeXConfig.load_merged_config
    options = build_default_options(cfg, prog_name, extra_cli_files)

    normalize_argv!(argv)
    parser = build_option_parser(options)
    parser.parse!(argv)
    handle_help_and_examples(parser, options, prog_name, argv)

    configure_environment(options)
    execute_targets(argv, options)
  end

  def self.early_personality_dispatch(argv, prog_name)
    if prog_name == 'latex_file_in_dir'
      dir = argv[0] || '.'
      puts LaTeXUtils.find_main_latex_file(dir)
      exit 0
    elsif %w[latex_clean clean_latex latex-clean].include?(prog_name)
      dispatch_clean_personality(argv, prog_name)
      exit 0
    end
    false
  end

  def self.dispatch_clean_personality(argv, prog_name)
    if argv.include?('-h') || argv.include?('--help')
      puts "Usage: #{prog_name} [directory...]"
      puts 'Clean all LaTeX auxiliary and junk files in the specified directory (default: current directory).'
      return
    end
    dirs = argv.empty? ? ['.'] : argv
    dirs.each do |d|
      target = File.directory?(d) ? d : File.dirname(d)
      LaTeXUtils.clean_directory(target)
    end
  end

  def self.extract_extra_cli_files(argv)
    return [] unless (sep_idx = argv.index('--'))

    extra = argv[(sep_idx + 1)..].flat_map { |f| Dir.glob(f).empty? ? [f] : Dir.glob(f) }
    argv.slice!(sep_idx..)
    extra
  end

  def self.resolve_symlink_engine(prog_name)
    if %w[ll llua lualatex_l].include?(prog_name)
      'lualatex'
    elsif %w[lp pdflatex_l pdflatex].include?(prog_name)
      'pdflatex'
    end
  end

  def self.build_default_options(cfg, prog_name, extra_cli_files)
    symlink_engine = resolve_symlink_engine(prog_name)
    is_lw = (prog_name == 'lw')
    is_env_free = %w[pdflatex_env_free latex_env_free bibtex_env_free].include?(prog_name)

    {
      engine: symlink_engine || cfg['engine'],
      engine_explicit: !symlink_engine.nil?,
      clean: false,
      force: false,
      single_pass: false,
      show_examples: false,
      show_help: false,
      show_main: false,
      clean_only: false,
      fast: is_lw || cfg['fast'] == true,
      update_on_diff: cfg['update_on_diff'] == true,
      bib: cfg['bib'],
      passes: (cfg['passes'] || 3).to_i.clamp(1, 3),
      time: cfg['time'] == true,
      lock: cfg.key?('lock') ? (cfg['lock'] == true) : true,
      score: false,
      color: cfg['color'],
      no_env: is_env_free,
      verbose: false,
      emacs: cfg['emacs'] == true,
      werror: cfg['werror'] == true,
      revtex4: cfg['revtex4'].is_a?(Hash) ? cfg['revtex4'] : {},
      alert_overfull_pt: (cfg['alert_overfull_pt'] || 24.0).to_f,
      whatever_overfull_pt: (cfg['whatever_overfull_pt'] || 2.5).to_f,
      suppress_whatevers: cfg.key?('suppress_whatevers') ? (cfg['suppress_whatevers'] == true) : true,
      suppress_warnings: cfg['suppress_warnings'] == true,
      suppress_alerts: cfg['suppress_alerts'] == true,
      all: false,
      explain: false,
      deps: false,
      zip: false,
      verify: false,
      zip_name: nil,
      inject_styles: cfg.dig('zip', 'inject_styles') == true,
      fig_sources: cfg.dig('zip', 'fig_sources') || ['.fig', '.ipe', '.svg', '.asy', '.gp', '.gnuplot', '.py', '.R'],
      extra_files: (Array(cfg.dig('zip', 'include')) + extra_cli_files).uniq,
      arxiv: false,
      arxiv_name: nil,
      meta_only: false,
      arxiv_verify: cfg.dig('arxiv', 'verify') != false,
      arxiv_visual_verify: cfg.dig('arxiv', 'visual_verify') != false,
      biblatex_shield: cfg.dig('arxiv', 'bundle_biblatex') != false,
      comments: cfg.dig('arxiv', 'comments')
    }
  end

  def self.normalize_argv!(argv)
    argv.map! do |arg|
      case arg
      when '-Werror' then '--werror'
      when '-emacs' then '--emacs'
      when '-pdflatex' then '--pdflatex'
      when '-xelatex' then '--xe'
      when '-lualatex' then '--lua'
      when '-help' then '--help'
      when '-version' then '--version'
      else arg
      end
    end
  end

  def self.build_option_parser(options)
    OptionParser.new do |opts|
      opts.banner = 'Usage: l [options] [document.tex]'
      opts.separator ''
      opts.separator 'Compilation Options:'
      add_compilation_options_primary(opts, options)
      add_compilation_options_secondary(opts, options)
      opts.separator ''
      opts.separator 'arXiv Preparation Options:'
      add_arxiv_options(opts, options)
      add_general_options(opts, options)
    end
  end

  def self.add_compilation_options_primary(opts, options)
    opts.on('-m', '--main', 'Print the detected main LaTeX file and exit') { options[:show_main] = true }
    opts.on('-C', '--clean-only', 'Clean auxiliary and junk files in directory and exit without building') { options[:clean_only] = true }
    opts.on('--fast', 'Fast incremental mode: reuse aux files and only run subsequent passes/biber/bibtex if needed') { options[:fast] = true }
    opts.on('-a', '--all', 'Show all diagnostics across all tiers (including Whatevers and Warnings)') do
      options[:all] = true
      options[:suppress_whatevers] = false
      options[:suppress_warnings] = false
      options[:suppress_alerts] = false
    end
    opts.on('-e', '--explain', 'Display boxed plain-English explanations for diagnostics on first occurrence') { options[:explain] = true }
    opts.on('--engine ENGINE', 'LaTeX compiler: xelatex (default), lualatex, or pdflatex') do |v|
      options[:engine] = LaTeXUtils.normalize_engine(v)
      options[:engine_explicit] = true
    end
    opts.on('--lua', 'Shortcut for --engine=lualatex') { options[:engine] = 'lualatex'; options[:engine_explicit] = true }
    opts.on('--xe', 'Shortcut for --engine=xelatex (default)') { options[:engine] = 'xelatex'; options[:engine_explicit] = true }
    opts.on('--pdf', 'Generate PDF output (default behavior)') { # No-op
    }
    opts.on('--pdflatex', 'Shortcut for --engine=pdflatex') { options[:engine] = 'pdflatex'; options[:engine_explicit] = true }
  end

  def self.add_compilation_options_secondary(opts, options)
    opts.on('-u', '--single-pass', 'Perform a single LaTeX run only (no BibTeX/Biber, no extra passes)') do
      options[:single_pass] = true
      options[:passes] = 1
      options[:bib] = false
    end
    opts.on('-1', '--force', 'Force initial LaTeX run, continuing with subsequent passes only if needed') { options[:force] = true }
    opts.on('-d', '--diff', 'Only replace target PDF if text content changed') { options[:update_on_diff] = true }
    opts.on('-c', '--clean', 'Clean temporary build files (junk/, .bbl, .aux) before building') { options[:clean] = true }
    opts.on('-b', '--[no-]bib', 'Force or skip BibTeX pass (default: auto-detect)') { |v| options[:bib] = v }
    opts.on('-n', '--passes NUM', Integer, 'Number of compilation passes (1-3, default: 3)') { |v| options[:passes] = v.clamp(1, 3) }
    opts.on('-T', '--time', 'Show execution time diagnostics per pass') { options[:time] = true }
    opts.on('-t', '--verify', 'Verify self-contained portability of generated zip in /tmp sandbox') { options[:verify] = true; options[:zip] = true }
    opts.on('-z', '--zip', 'Create self-contained portable zip archive of paper') { options[:zip] = true }
    opts.on('--zip-name NAME', 'Specify custom output name for zip archive') { |v| options[:zip] = true; options[:zip_name] = v }
    opts.on('--[no-]inject-styles', 'Enable or disable isolating harvested styles into styles/ and injecting \input@path') { |v| options[:inject_styles] = v }
    opts.on('--init-config', 'Create a local .l.jsonc configuration template in the current directory and exit') do
      LaTeXConfig.create_local_template!('.')
      exit 0
    end
    opts.on('--[no-]color', 'Enable or disable colored terminal output (default: auto)') { |v| options[:color] = v }
    opts.on('--[no-]lock', 'Enable or disable lockfile concurrency protection (default: enabled)') { |v| options[:lock] = v }
    opts.on('-s', '--score', 'Suppress stdout and output error/warning count from the last LaTeX run') { options[:score] = true }
    opts.on('--no-env', 'Reset environment variables used by LaTeX/BibTeX/Biber') { options[:no_env] = true }
    opts.on('--emacs', 'Format warnings/errors for Emacs AUCTeX integration (suppress line prefixes)') { options[:emacs] = true }
    opts.on('-v', '--verbose', 'Verbose output (e.g. show box text snippets)') { options[:verbose] = true }
    opts.on('-W', '--werror', 'Treat compilation warnings as fatal errors and exit with non-zero code') { options[:werror] = true }
    opts.on('-M', '--deps', 'Print Makefile dependency rule for the document and exit') { options[:deps] = true }
    opts.on('--alert-hbox PT', Float, 'Overfull hbox threshold in pt to classify as Alert (default: 24.0)') { |v| options[:alert_overfull_pt] = v.to_f }
    opts.on('--whatever-pt PT', Float, 'Overfull hbox threshold in pt to classify as Whatever (default: 2.5)') { |v| options[:whatever_overfull_pt] = v.to_f }
  end

  def self.add_arxiv_options(opts, options)
    opts.on('--arxiv', 'Prepare sanitized, flattened, submission-ready arXiv zip package') { options[:arxiv] = true }
    opts.on('--arxiv-name NAME', 'Specify custom output name for arXiv zip package') { |v| options[:arxiv] = true; options[:arxiv_name] = v }
    opts.on('--meta', 'Extract and display sanitized paper metadata and write arxiv_<file>_meta.txt') { options[:meta_only] = true }
    opts.on('--[no-]arxiv-verify', 'Enable/disable sandbox compile plus exact PDF text verification (default: true)') { |v| options[:arxiv_verify] = v }
    opts.on('--[no-]arxiv-visual-verify', 'Enable/disable rendered PDF page verification (default: true; requires pdftoppm)') { |v| options[:arxiv_visual_verify] = v }
    opts.on('--[no-]biblatex-shield', 'Enable or disable bundling local biblatex distribution files (default: true)') { |v| options[:biblatex_shield] = v }
  end

  def self.add_general_options(opts, options)
    opts.separator ''
    opts.separator 'General Options:'
    opts.on('-V', '--version', 'Show version') do
      puts "l #{LatexIt::VERSION}"
      exit 0
    end
    opts.on('-E', '--examples', 'Show detailed usage examples and common workflows') { options[:show_examples] = true }
    opts.on('-h', '--help', 'Show this help message') { options[:show_help] = true }
  end

  def self.handle_help_and_examples(parser, options, prog_name, argv = [])
    if options[:show_main]
      dir = argv[0] || '.'
      puts LaTeXUtils.find_main_latex_file(dir)
      exit 0
    elsif options[:clean_only]
      dir = argv[0] || '.'
      target = File.directory?(dir) ? dir : File.dirname(dir)
      LaTeXUtils.clean_directory(target)
      exit 0
    end

    if options[:show_help] && options[:show_examples]
      puts parser
      puts "\n#{LaTeXUtils.detailed_examples}"
      exit 0
    elsif options[:show_examples]
      puts LaTeXUtils.detailed_examples(parser.banner)
      exit 0
    elsif options[:show_help]
      puts parser
      puts "\nFor detailed usage examples and common workflows, run: #{prog_name} -E"
      exit 0
    end
  end

  def self.configure_environment(options)
    Rainbow.enabled = false if options[:emacs] && options[:color].nil?
    Rainbow.enabled = options[:color] unless options[:color].nil?

    LaTeXUtils.reset_latex_environment! if options[:no_env]
  end

  def self.execute_targets(argv, options)
    targets = argv.empty? ? [LaTeXUtils.find_main_latex_file] : argv
    targets.each do |target|
      if options[:meta_only]
        process_meta_target(target, options)
      elsif options[:arxiv]
        process_arxiv_target(target, options)
      else
        process_standard_target(target, options)
      end
    end
  end

  def self.process_meta_target(target, options)
    bname = File.basename(target, '.tex')
    pdf_path = File.file?("#{bname}.pdf") ? "#{bname}.pdf" : "junk/#{bname}.pdf"
    fls_path = "junk/#{bname}.fls"
    log_path = "junk/#{bname}.log"

    meta = LaTeXMetaExtractor.extract(target, '.', pdf_path, fls_path, log_path, options[:comments])
    meta_txt = LaTeXMetaExtractor.format_meta_txt(meta)
    meta_filename = "arxiv_#{bname}_meta.txt"
    LaTeXMetaExtractor.write_meta_file(meta_filename, meta_txt)

    puts Rainbow("\n========================= Paper Metadata =========================").cyan.bright
    puts meta_txt
    puts Rainbow('==================================================================').cyan.bright
    puts Rainbow("==> Wrote paper metadata to: #{meta_filename}\n").green.bright
  end

  def self.process_arxiv_target(target, options)
    builder = LatexBuilder.new(target, options)
    arxiv_packager = LatexArxivPackager.new(builder, options)
    exit 1 unless arxiv_packager.package!
  end

  def self.process_standard_target(target, options)
    builder = LatexBuilder.new(target, options)
    exit 1 unless builder.run!

    if options[:zip] || options[:verify]
      packager = LatexPackager.new(builder)
      exit 1 unless packager.package!
    end
  end
end

if __FILE__ == $PROGRAM_NAME || (File.exist?($PROGRAM_NAME) && File.identical?(__FILE__, $PROGRAM_NAME))
  LatexCLI.run
end
