module LaTeXConfig
  CONFIG_DIR = File.expand_path('~/.config/latex_it')
  GLOBAL_CONFIG_FILE = File.join(CONFIG_DIR, 'config.jsonc')
  LOCAL_CONFIG_CANDIDATES = ['.l.jsonc', '.latex_it.jsonc'].freeze

  DEFAULT_CONFIG_TEMPLATE = <<~JSONC
    {
      // =========================================================================
      // latex_it Global Configuration File
      // Location: ~/.config/latex_it/config.jsonc
      //
      // Project-level overrides can be placed in .l.jsonc (or .latex_it.jsonc).
      // CLI flags always override settings defined here.
      // =========================================================================

      // LaTeX engine: "xelatex" (default) or "lualatex"
      "engine": "xelatex",

      // Fast incremental mode: reuse .aux and skip redundant passes
      "fast": false,

      // Maximum compilation passes (1-3, default: 3)
      "passes": 3,

      // Only update target PDF if extracted text content changed (requires pdftotext)
      "update_on_diff": false,

      // Display execution timing diagnostics per pass (-T / --time)
      "time": false,

      // Terminal color output: true (force), false (disable), or null (auto-detect)
      "color": null,

      // Lockfile concurrency protection
      "lock": false,

      // Treat compilation warnings as fatal errors (-W / --werror)
      "werror": false,

      // Format warnings/errors for Emacs AUCTeX integration
      "emacs": false,

      // Portable Zip Bundling Settings (invoked via `l -z`)
      "zip": {
        // When true, harvested style files are placed in styles/ and \\input@path
        // is injected into the packaged .tex file.
        // When false (default), harvested styles sit in the archive root.
        "inject_styles": false,

        // Additional figure source file extensions to auto-discover
        "fig_sources": [".fig", ".ipe", ".svg", ".asy", ".gp", ".gnuplot", ".py", ".R"],

        // Supplementary files or glob patterns to always bundle in this project
        "include": []
      }
    }
  JSONC

  def self.ensure_global_config_exists!
    return if File.exist?(GLOBAL_CONFIG_FILE)

    FileUtils.mkdir_p(CONFIG_DIR)
    File.write(GLOBAL_CONFIG_FILE, DEFAULT_CONFIG_TEMPLATE)
  rescue StandardError
    # Silently ignore if unable to create in restricted environments
  end

  def self.create_local_template!(dir = '.')
    local_path = File.join(dir, '.l.jsonc')
    if File.exist?(local_path)
      warn " -- Local config already exists: #{local_path}"
      return
    end

    File.write(local_path, DEFAULT_CONFIG_TEMPLATE)
    puts "Created local configuration file: #{local_path}"
  end

  def self.parse_jsonc(content)
    return {} if content.nil? || content.strip.empty?

    in_string = false
    escaped = false
    out = []
    i = 0
    len = content.length
    while i < len
      c = content[i]
      if in_string
        out << c
        if escaped
          escaped = false
        elsif c == '\\'
          escaped = true
        elsif c == '"'
          in_string = false
        end
      elsif c == '"'
        in_string = true
        out << c
      elsif c == '/' && content[i + 1] == '/'
        i = content.index("\n", i) || len
        next
      elsif c == '/' && content[i + 1] == '*'
        end_idx = content.index('*/', i + 2)
        i = end_idx ? end_idx + 2 : len
        next
      else
        out << c
      end
      i += 1
    end
    clean = out.join.gsub(/,(\s*[}\]])/, '\1')
    JSON.parse(clean)
  rescue JSON::ParserError => e
    warn " -- Warning: Could not parse JSONC config (#{e.message}); using defaults."
    {}
  rescue StandardError
    {}
  end

  def self.load_merged_config(dir = '.')
    ensure_global_config_exists!

    global_cfg = File.exist?(GLOBAL_CONFIG_FILE) ? parse_jsonc(File.read(GLOBAL_CONFIG_FILE)) : {}

    local_cfg = {}
    found_local = false
    LOCAL_CONFIG_CANDIDATES.each do |candidate|
      path = File.join(dir, candidate)
      if File.exist?(path)
        local_cfg = parse_jsonc(File.read(path))
        found_local = true
        break
      end
    end

    LaTeXUtils.load_config_latex(dir) unless found_local

    deep_merge(global_cfg, local_cfg)
  end

  def self.deep_merge(hash1, hash2)
    merged = hash1.dup
    hash2.each do |k, v|
      merged[k] = if v.is_a?(Hash) && merged[k].is_a?(Hash)
                    deep_merge(merged[k], v)
                  else
                    v
                  end
    end
    merged
  end
end

module LaTeXUtils
  PDFLATEX_ERROR = 'PDFLatex by now is outdated. It does not support utf8, and should probably be avoided.'

  def self.pdflatex?(name)
    return false if name.nil?

    eng = name.to_s.strip.downcase
    first_token = eng.split.first || ''
    base = File.basename(first_token, '.*')
    %w[pdflatex pdf pdftex].include?(base) || eng == 'pdflatex' || eng.start_with?('pdflatex')
  end

  def self.check_engine!(name)
    return unless name

    if pdflatex?(name)
      warn PDFLATEX_ERROR
      exit 1
    end
  end

  def self.normalize_engine(engine)
    return 'xelatex' if engine.nil? || engine.to_s.strip.empty?

    eng = engine.to_s.strip.downcase
    first_token = eng.split.first || ''
    base = File.basename(first_token, '.*')
    case base
    when 'lua', 'lualatex', 'luatex'
      'lualatex'
    when 'xe', 'xelatex', 'xetex'
      'xelatex'
    when 'pdf', 'pdflatex', 'pdftex'
      'pdflatex'
    else
      base
    end
  end

  def self.detect_engine_from_file(path)
    return nil unless path && File.file?(path)

    content = safe_read(path)
    return nil if content.empty?

    # 1. Check magic comments in the top lines of the file
    header_lines = content.lines.first(50) || []
    header_lines.each do |line|
      if line =~ /^\s*%\s*!T[eE]X\s+(?:TS-)?(?:program|engine)\s*=\s*(\S+)/i
        raw = Regexp.last_match(1).strip
        return normalize_engine(raw)
      end
    end

    # 2. Check AUCTeX / Emacs Local Variables block at bottom of file
    tail_lines = content.lines.last(40) || []
    tail_lines.each do |line|
      if line =~ /TeX-engine:\s*([a-zA-Z0-9_-]+)/i
        raw = Regexp.last_match(1).strip
        return normalize_engine(raw)
      end
    end

    # 3. Check Lua-specific packages or code
    if content =~ /\\usepackage(?:\[.*?\])?\{luacode\}/ ||
       content =~ /\\usepackage(?:\[.*?\])?\{luamplib\}/ ||
       content =~ /\\usepackage(?:\[.*?\])?\{luatex85\}/ ||
       content.include?('\\directlua')
      return 'lualatex'
    end

    nil
  end

  def self.safe_read(path)
    return '' unless path && File.file?(path)

    File.read(path, mode: 'r:binary', invalid: :replace, undef: :replace)
  rescue StandardError
    ''
  end

  def self.filter_subcommand_noise(text)
    return '' if text.nil? || text.empty?

    # Strip mktextfm / mktexpk / METAFONT sub-process invocations and their internal errors
    text.gsub(/(?:kpathsea: Running mktex\S+|mktex\S+: Running mf).*?(?:failed to make \S+|Transcript written on mfput\.log\.)\n?/m, '')
  end

  def self.bbl_has_entries?(path)
    return false unless path && File.file?(path) && File.size(path) > 0

    content = safe_read(path)
    content.include?('\bibitem') || content.include?('\entry{')
  end

  def self.command_available?(cmd)
    ENV['PATH'].to_s.split(File::PATH_SEPARATOR).any? do |dir|
      bin = File.join(dir, cmd.to_s)
      File.file?(bin) && File.executable?(bin)
    end
  end

  def self.check_program(cmd)
    return if command_available?(cmd)

    warn "ERROR: #{cmd} could not be found in PATH"
    exit 1
  end

  def self.load_config_latex(dir = '.')
    config_file = File.join(dir, '.config_latex')
    return unless File.exist?(config_file)
    return if ENV['LOADED_LATEX_CFG']

    warn ' -- Loading local LaTeX preferences from .config_latex'
    content = safe_read(config_file)
    content.each_line do |line|
      line = line.strip
      next if line.empty? || line.start_with?('#')

      line = line.sub(/^export\s+/, '')
      if line =~ /\A([A-Za-z0-9_]+)=(.*)\z/
        key = Regexp.last_match(1)
        val = Regexp.last_match(2).gsub(/\A["']|["']\z/, '')
        ENV[key] = val
      end
    end
    ENV['LOADED_LATEX_CFG'] = '1'
  end

  def self.find_main_latex_file(dir = '.')
    mainfile = File.join(dir, '.mainfile')
    if File.exist?(mainfile)
      main_file = File.read(mainfile).strip
      return main_file unless main_file.empty?
    end

    search_path = (dir == '.' ? '*.tex' : File.join(dir, '*.tex'))
    raw_files = Dir[search_path].map { |f| File.basename(f) }

    candidates = raw_files.reject do |f|
      f =~ /\.num\.tex\z/ ||
        f =~ /\Aprefix.*\.tex\z/ ||
        f =~ /\Aprelim.*\.tex\z/ ||
        f =~ /\Apreamble.*\.tex\z/ ||
        f == 'pratenddefaultcategory.tex' ||
        f.start_with?('flycheck_') ||
        f.start_with?('.') ||
        f.end_with?('~') ||
        f.end_with?('.bak')
    end

    if candidates.empty?
      warn "Error: No LaTeX (.tex) files found in directory '#{File.expand_path(dir)}'."
      exit 1
    end

    return candidates.first if candidates.size == 1

    # Heuristic 1: Directory name match (e.g. no_spread_ann.tex in no_spread_ann/)
    dir_name = File.basename(File.expand_path(dir))
    dir_match = "#{dir_name}.tex"
    return dir_match if candidates.include?(dir_match)

    # Heuristic 2: Check for \begin{document} or \documentclass in candidates
    with_doc = candidates.select do |f|
      c = safe_read(File.join(dir, f))
      c.include?('\begin{document}') || c.include?('\documentclass')
    end
    return with_doc.first if with_doc.size == 1

    # Heuristic 3: Check for existing matching output PDF or BBL
    with_pdf = candidates.select do |f|
      base = File.basename(f, '.tex')
      File.exist?(File.join(dir, "#{base}.pdf")) || File.exist?(File.join(dir, 'junk', "#{base}.pdf"))
    end
    return with_pdf.first if with_pdf.size == 1

    warn 'Error: Multiple candidate .tex files found. Please specify which file to compile, or'
    warn '       create a .mainfile containing the name of the main LaTeX file:'
    candidates.each { |f| warn "  #{f}" }
    exit 1
  end

  def self.clean_directory(dir = '.', verbose = true)
    target_dir = File.expand_path(dir)
    return unless File.directory?(target_dir)

    puts "Cleaning LaTeX auxiliary files in #{target_dir}..." if verbose

    Dir.chdir(target_dir) do
      # Remove build directories
      %w[junk styles/junk figs/junk figs/bak refs/junk].each do |d|
        FileUtils.rm_rf(d) if File.exist?(d)
      end

      # Remove temporary / junk LaTeX extensions
      patterns = [
        '*.{aux,bbl,bbl.bak,blg,bcf,run.xml}',
        '*.{log,out,toc,lof,lot,thm,idx,ind,ilg}',
        '*.{nav,snm,vrb,synctex.gz,synctex,dvi,ps}',
        '*.{fls,fdb_latexmk,rel,vtc,axp,dpth,md5,soc,build_state.json}',
        '.build_state.json',
        'log.txt', 'log.txt.1', 'texput.log',
        'missfont.log', 'mfput.log',
        '*.err*', 'err_*',
        'flycheck_*.tex'
      ]

      patterns.each do |pat|
        Dir.glob(pat).each do |f|
          FileUtils.rm_f(f) if File.file?(f)
        end
      end
    end
  end

  def self.reset_latex_environment!
    vars = %w[
      BIBINPUTS
      BSTINPUTS
      TEXINPUTS
      PDFTEXINPUTS
      XETEXINPUTS
      LUATEXINPUTS
      LUAINPUTS
      BBLINPUTS
      TEXMFOUTPUT
      TEXFORMATS
      TEXFONTS
      TFMFONTS
      T1FONTS
      OFMFONTS
      AFMFONTS
      TTFONTS
      OPENTYPEFONTS
      MFINPUTS
      MPINPUTS
      TEXPICTS
      TEXDOCS
      TEXSOURCES
      TEXPOOL
      INDEXSTYLE
      BIBTEX_PREFIX
    ]
    vars.each { |var| ENV.delete(var) }
    ENV.keys.each do |key|
      ENV.delete(key) if key =~ /\A(?:TEX|BIB|BST|LUA|MF|MP)INPUTS/i
    end
  end
end

class LatexBuilder
  attr_reader :options, :filename, :bfilename, :bdir, :engine_name

  def initialize(target, options)
    @options = options
    @bdir = File.dirname(target)
    @target_base = File.basename(target)
    @bfilename = File.basename(@target_base, '.*')
    @filename = "#{@bfilename}.tex"
    @orig_stdout = $stdout
    @engine_name = LaTeXUtils.normalize_engine(@options[:engine] || 'xelatex')
    @pdferr = "junk/err_#{@engine_name}"
    @biberrbase = 'err_bib'
    @biberr = "junk/#{@biberrbase}"
  end

  def run!
    if @options[:score]
      @orig_stdout = $stdout
      $stdout = File.open(File::NULL, 'w')
      begin
        if @bdir != '.'
          Dir.chdir(@bdir) { compile_target }
        else
          compile_target
        end
      ensure
        $stdout.close rescue nil
        $stdout = @orig_stdout
      end
    elsif @bdir != '.'
      puts "      cd #{@bdir}"
      Dir.chdir(@bdir) { compile_target }
    else
      compile_target
    end
  end

  private

  def compile_target
    unless File.exist?(@filename)
      warn "Error: File '#{@filename}' not found."
      exit 1
    end

    if @options[:deps]
      export_dependencies
      return
    end

    with_lock do
      setup_environment
      deep_clean if @options[:clean]
      paper_cleanup

      if targets_up_to_date?
        puts "      #{Rainbow("All targets (#{@bfilename}.pdf) are up-to-date.").green} (Use 'l -u' to force rebuild)"
        return
      end

      junk_dir_create
      total_t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC) if @options[:time]

      run_convergence_loop
      puts ''

      # Update output files
      update_target_file("junk/#{@bfilename}.pdf", "#{@bfilename}.pdf", update_on_diff: @options[:update_on_diff])
      update_target_file("junk/#{@bfilename}.bbl", "#{@bfilename}.bbl") if LaTeXUtils.bbl_has_entries?("junk/#{@bfilename}.bbl")
      update_target_file("junk/#{@bfilename}.synctex.gz", "#{@bfilename}.synctex.gz")

      save_build_state!

      if @options[:time]
        total_t1 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
        printf("Total Build Time: %s seconds\n", Rainbow(format('%.2f', total_t1 - total_t0)).green.bright)
      end

      analyze_output
    end
  end

  def targets_up_to_date?
    return false if @options[:clean] || @options[:single_pass] || @options[:score] || @options[:werror]

    target_pdf = "#{@bfilename}.pdf"
    return false unless File.exist?(target_pdf) && File.size(target_pdf) > 0

    state_file = 'junk/.build_state.json'
    return false unless File.exist?(state_file)

    state = JSON.parse(File.read(state_file)) rescue nil
    return false unless state.is_a?(Hash) && state['target'] == target_pdf

    sources = state['sources']
    return false unless sources.is_a?(Hash) && !sources.empty?

    pdf_mtime = File.mtime(target_pdf)
    root_files = Dir['*.tex', '*.bib', 'refs/*.bib'].select { |f| File.file?(f) }
    return false if root_files.any? { |f| File.mtime(f) > pdf_mtime }

    sources.all? do |path, meta|
      next false unless File.exist?(path)

      if meta['mtime'] && File.mtime(path).to_i == meta['mtime']
        true
      else
        meta['sha'] && Digest::SHA256.file(path).hexdigest == meta['sha']
      end
    end
  end

  def run_convergence_loop
    if @options[:single_pass]
      print "      #{Rainbow(@engine_name).bright}"
      run_latex_pass('_1')
      return
    end

    max_passes = @options[:passes]
    pass = 0
    bib_ran = false

    bib_tool = detect_bib_tool
    if bib_tool && bib_files_newer_than_bbl?
      print "      #{Rainbow(bib_tool).bright}"
      run_bib_pass(bib_tool)
      bib_ran = true
    end

    loop do
      pass += 1
      prefix = (pass == 1 && !bib_ran) ? '      ' : ', '
      print "#{prefix}#{Rainbow(@engine_name).bright} (#{pass})"

      aux_before = compute_aux_hash
      run_latex_pass("_#{pass}")

      break if pass >= max_passes

      bib_tool ||= detect_bib_tool
      if bib_tool && !bib_ran && needs_bib_pass?(bib_tool, "#{@pdferr}_#{pass}")
        print ", #{Rainbow(bib_tool).bright}"
        run_bib_pass(bib_tool)
        bib_ran = true
        next
      end

      break unless needs_latex_rerun?("#{@pdferr}_#{pass}", aux_before)
    end
  end

  def bib_files_newer_than_bbl?
    fnbbl = "junk/#{@bfilename}.bbl"
    return false unless File.exist?(fnbbl) && File.size(fnbbl) > 0
    return false unless File.exist?("junk/#{@bfilename}.aux") || File.exist?("junk/#{@bfilename}.bcf")

    bbl_mtime = File.mtime(fnbbl)
    bib_files = Dir['*.bib', 'refs/*.bib'].select { |f| File.file?(f) }
    bib_files.any? { |b| File.mtime(b) > bbl_mtime }
  end

  def extract_fls_dependencies(fls_path)
    return [] unless File.exist?(fls_path)

    root_abs = File.expand_path('.')
    deps = []

    File.foreach(fls_path) do |line|
      next unless line.start_with?('INPUT ')

      path = line.sub(/\AINPUT\s+/, '').strip
      next if path.empty?

      abs = File.expand_path(path)
      if abs.start_with?(root_abs) && File.file?(abs)
        rel = abs.sub(%r{\A#{Regexp.escape(root_abs)}/?}, '')
        next if rel.start_with?('junk/') || rel.empty?

        deps << rel
      end
    end

    deps.uniq
  end

  def save_build_state!
    return unless File.exist?("junk/#{@bfilename}.pdf") && File.size("junk/#{@bfilename}.pdf") > 0

    fls_path = "junk/#{@bfilename}.fls"
    deps = extract_fls_dependencies(fls_path)
    deps << @filename if File.exist?(@filename)
    Dir['*.bib', 'refs/*.bib'].select { |f| File.file?(f) }.each { |b| deps << b }
    deps.uniq!

    sources = {}
    deps.each do |dep|
      next unless File.file?(dep)

      sources[dep] = {
        'mtime' => File.mtime(dep).to_i,
        'sha' => Digest::SHA256.file(dep).hexdigest
      }
    end

    state = {
      'target' => "#{@bfilename}.pdf",
      'engine' => @engine_name,
      'saved_at' => Time.now.to_i,
      'sources' => sources
    }

    File.write('junk/.build_state.json', JSON.generate(state))
  rescue StandardError => e
    warn "Warning: Could not save build state: #{e.message}" if @options[:verbose]
  end

  def export_dependencies
    deps = []
    if File.exist?('junk/.build_state.json')
      state = JSON.parse(File.read('junk/.build_state.json')) rescue nil
      deps = state['sources'].keys if state.is_a?(Hash) && state['sources'].is_a?(Hash)
    end

    if deps.empty? && File.exist?("junk/#{@bfilename}.fls")
      deps = extract_fls_dependencies("junk/#{@bfilename}.fls")
    end

    if deps.empty?
      with_lock do
        setup_environment
        junk_dir_create
        run_latex_pass('_1')
        save_build_state!
      end
      if File.exist?('junk/.build_state.json')
        state = JSON.parse(File.read('junk/.build_state.json')) rescue nil
        deps = state['sources'].keys if state.is_a?(Hash) && state['sources'].is_a?(Hash)
      end
    end

    deps << @filename if File.exist?(@filename)
    Dir['*.bib', 'refs/*.bib'].select { |f| File.file?(f) }.each { |b| deps << b }
    deps.uniq!
    deps.sort!

    puts "#{@bfilename}.pdf: #{deps.join(' ')}"
  end

  def with_lock
    return yield unless @options[:lock]

    FileUtils.mkdir_p('/tmp/sariel/latex')
    lock_file = "/tmp/sariel/latex/#{@bfilename}.lock"
    File.open(lock_file, File::RDWR | File::CREAT, 0o644) do |f|
      f.flock(File::LOCK_EX)
      yield
    ensure
      f.flock(File::LOCK_UN) rescue nil
    end
  end

  def setup_environment
    FileUtils.mkdir_p('junk/junk')
    FileUtils.mkdir_p('junk/figs')
    FileUtils.mkdir_p('junk/fragment')

    LaTeXUtils.load_config_latex
    LaTeXUtils.reset_latex_environment! if @options[:no_env]

    file_engine = LaTeXUtils.detect_engine_from_file(@filename)

    candidate_engine = @options[:engine] ||
                       ENV['PDFBINONLY'] ||
                       file_engine ||
                       ENV['PDFBIN'] ||
                       ENV['LATEX_ENGINE'] ||
                       'xelatex'

    LaTeXUtils.check_engine!(candidate_engine)

    @engine_name = LaTeXUtils.normalize_engine(candidate_engine)
    LaTeXUtils.check_engine!(@engine_name)
    LaTeXUtils.check_program(@engine_name)

    @latex_flags = ['-interaction=nonstopmode', '-synctex=1', '-no-mktex=tfm', '-recorder', '-output-directory=junk', '-file-line-error']

    @pdferr = "junk/err_#{@engine_name}"
    @biberrbase = 'err_bib'
    @biberr = "junk/#{@biberrbase}"
    @log = 'junk/log.txt'
    @loga = 'junk/log.txt.1'

    FileUtils.rm_f([@log, @loga, @biberr, @pdferr, "#{@pdferr}_1", "#{@pdferr}_2", "#{@pdferr}_3"])
  end

  def junk_dir_create
    FileUtils.mkdir_p('junk/figs')
    FileUtils.mkdir_p('junk/junk')
    FileUtils.mkdir_p('junk/fragment')
  end

  def deep_clean
    LaTeXUtils.clean_directory('.', true)
  end

  def paper_cleanup
    if File.exist?("#{@bfilename}.aux") && !File.exist?("junk/#{@bfilename}.aux") && !File.exist?("junk/old/#{@bfilename}.aux")
      FileUtils.mkdir_p('junk')
      FileUtils.cp("#{@bfilename}.aux", "junk/#{@bfilename}.aux")
    end

    root_bbl = "#{@bfilename}.bbl"
    if File.exist?(root_bbl) && !File.exist?("junk/#{root_bbl}") && !File.exist?("junk/old/#{root_bbl}") && LaTeXUtils.bbl_has_entries?(root_bbl)
      FileUtils.mkdir_p('junk')
      FileUtils.cp(root_bbl, "junk/#{root_bbl}")
    end

    files = ["#{@bfilename}.ps", 'log.txt', "#{@bfilename}.blg", "#{@bfilename}.dvi",
             "#{@bfilename}.thm", "#{@bfilename}.aux", "#{@bfilename}.idx", "#{@bfilename}.log",
             "#{@bfilename}.out", "#{@bfilename}.vtc", 'texput.log', 'missfont.log', 'mfput.log',
             "#{@bfilename}.bcf", "#{@bfilename}.run.xml"]
    files.each { |f| FileUtils.rm_f(f) }

    root_bbl = "#{@bfilename}.bbl"
    FileUtils.rm_f(root_bbl) if File.exist?(root_bbl) && !LaTeXUtils.bbl_has_entries?(root_bbl)
  end

  def run_latex_pass(suffix)
    t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC) if @options[:time]
    lgx = "#{@pdferr}#{suffix}"
    FileUtils.rm_f(lgx)

    latexopts = ENV['LATEXOPTS'] || ''
    latexoptions = ENV['LATEXOPTIONS'] || ''

    cfilename = if !latexoptions.empty?
                  "#{latexoptions} \\input{#{@filename}}"
                elsif !latexopts.empty?
                  "#{latexopts}\\input{#{@filename}}"
                else
                  "\\input{#{@filename}}"
                end

    cmd_args = [@engine_name] + @latex_flags + [cfilename]

    File.open(lgx, 'a') do |f|
      f.puts '========================================'
      f.puts cmd_args.map(&:to_s).join(' ')
      f.puts '========================================'
      f.puts Time.now.strftime('%a %b %d %H:%M:%S %Z %Y')
      f.puts '========================================'
    end

    stdout_stderr, status = Open3.capture2e(*cmd_args)
    st = status.exitstatus || 0

    File.open(lgx, 'a') { |f| f.write(stdout_stderr) }

    if st > 0
      puts "\nLaTeX process exited with status: #{st}\n"
    end

    errcnt = count_errors_in_log(st, lgx)
    if errcnt > 0
      if @options[:score]
        output_score(lgx, st)
        exit 1
      else
        report_errors(lgx)
      end
    end

    File.open(@log, 'a') { |f| f.write(stdout_stderr) }

    if @options[:time]
      t1 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
      printf(" [%s]", Rainbow(format('%.2fs', t1 - t0)).green)
    end
  end

  def detect_bib_tool
    return nil if @options[:bib] == false

    # Check for Biber / BibLaTeX control files
    if File.exist?("junk/#{@bfilename}.bcf")
      bcf_content = LaTeXUtils.safe_read("junk/#{@bfilename}.bcf")
      return :biber if bcf_content.include?('<bcf:citekey>') || @options[:bib] == true
    end

    run_xml_path = "junk/#{@bfilename}.run.xml"
    if File.exist?(run_xml_path)
      run_xml_content = LaTeXUtils.safe_read(run_xml_path)
      return :biber if run_xml_content =~ /biber/i && (run_xml_content =~ /active="1"/ || @options[:bib] == true)
    end

    aux_files = Dir.glob('junk/**/*.aux')
    return (@options[:bib] == true ? :bibtex : nil) if aux_files.empty?

    aux_contents = aux_files.map { |f| LaTeXUtils.safe_read(f) }.join("\n")

    if aux_contents.include?('\abx@aux@bcf')
      bcf_path = "junk/#{@bfilename}.bcf"
      if File.exist?(bcf_path)
        bcf_content = LaTeXUtils.safe_read(bcf_path)
        return :biber if bcf_content.include?('<bcf:citekey>') || @options[:bib] == true
      elsif @options[:bib] == true
        return :biber
      end
    end

    # BibTeX is needed only when \bibdata{...} AND \citation are present in the .aux file
    if aux_contents =~ /\\bibdata\{/ && (aux_contents =~ /\\citation/ || @options[:bib] == true)
      return :bibtex if @options[:bib] == true

      # Skip bibtex if valid .bbl exists and no requested .bib files exist on disk
      has_bbl = LaTeXUtils.bbl_has_entries?("junk/#{@bfilename}.bbl") || LaTeXUtils.bbl_has_entries?("#{@bfilename}.bbl")
      return nil if has_bbl && !bib_files_exist_for_bibdata?(aux_contents)

      return :bibtex
    end

    # If user explicitly forced bib pass (-b / --bib), fallback to bibtex
    return :bibtex if @options[:bib] == true

    nil
  end

  def bib_files_exist_for_bibdata?(aux_contents)
    targets = aux_contents.scan(/\\bibdata\{([^}]+)\}/).flatten.flat_map { |s| s.split(',') }.map(&:strip)
    return true if targets.empty?

    bib_dirs = ['.', 'refs'] + ENV['BIBINPUTS'].to_s.split(':').reject(&:empty?)
    targets.any? do |target|
      bib_dirs.any? do |d|
        File.file?(File.join(d, "#{target}.bib")) || File.file?(File.join(d, target))
      end
    end
  end

  def run_bib_pass(tool)
    t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC) if @options[:time]
    fnbbl = "junk/#{@bfilename}.bbl"
    fnbblbak = "junk/#{@bfilename}.bbl.bak"

    Dir['*.bib'].each { |b| FileUtils.cp(b, 'junk/') }

    if tool == :biber
      biber_out, = Dir.chdir('junk') do
        Open3.capture2e('biber', '--output_safechars', '--input-directory', '.', '--output-directory', '.', @bfilename)
      end
      File.write(@biberr, biber_out)
      Dir['junk/*.bbl'].each { |b| FileUtils.cp(b, '.') if LaTeXUtils.bbl_has_entries?(b) }
      FileUtils.cp(fnbbl, fnbblbak) if File.exist?(fnbbl) && File.size(fnbbl) > 0
    elsif tool == :bibtex
      bib_out, = Dir.chdir('junk') do
        FileUtils.mkdir_p('styles')
        Dir['../styles/*'].each do |s|
          if File.directory?(s)
            FileUtils.cp_r(s, 'styles/')
          else
            FileUtils.cp(s, 'styles/')
          end
        end
        Open3.capture2e('bibtex', @bfilename)
      end

      File.write(@biberr, bib_out)
      Dir['junk/*.bbl'].each { |b| FileUtils.cp(b, '.') if LaTeXUtils.bbl_has_entries?(b) }
      FileUtils.cp(fnbbl, fnbblbak) if File.exist?(fnbbl) && File.size(fnbbl) > 0

      bbl_content = LaTeXUtils.safe_read(fnbbl)
      bbl = bbl_content.scan(/\\bibitem/).size
      bblx = bbl_content.scan(/biblatex/i).size

      puts "\nEmpty bibliography." if bbl == 0 && bblx == 0
    end

    if @options[:time]
      t1 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
      printf(" [%s]", Rainbow(format('%.2fs', t1 - t0)).green)
    end
  end

  def compute_aux_hash
    aux_files = Dir.glob('junk/**/*.aux').sort
    aux_files.map { |f| "#{f}:#{LaTeXUtils.safe_read(f)}" }.join("\n")
  end

  def needs_bib_pass?(tool, loga)
    return false if @options[:bib] == false
    return true if @options[:bib] == true

    fnbbl = "junk/#{@bfilename}.bbl"
    return true unless File.exist?(fnbbl) && File.size(fnbbl) > 0

    bbl_mtime = File.mtime(fnbbl)

    # Check if any .bib file is newer than .bbl
    bib_files = Dir['*.bib', 'refs/*.bib'].select { |f| File.file?(f) }
    return true if bib_files.any? { |b| File.mtime(b) > bbl_mtime }

    # Check log for explicit rerun request
    log_content = LaTeXUtils.safe_read(loga)
    return true if log_content =~ /Please \(re\)run Biber/i
    return true if log_content =~ /No file .*\.bbl/i
    return true if log_content =~ /Citation .* undefined/i
    return true if log_content =~ /There were undefined citations/i
    return true if log_content =~ /Package biblatex Warning: Please rerun/i
    return true if log_content =~ /Package natbib Warning: Citation\(s\) may have changed/i

    false
  end

  def needs_latex_rerun?(loga, prev_aux_hash = nil)
    curr_aux_hash = compute_aux_hash
    if prev_aux_hash && !prev_aux_hash.empty?
      return true if curr_aux_hash != prev_aux_hash
    elsif prev_aux_hash && prev_aux_hash.empty?
      return true if aux_has_cross_references?(curr_aux_hash)
    end

    log_content = LaTeXUtils.safe_read(loga)
    return true if log_content =~ /Label\(s\) may have changed/i
    return true if log_content =~ /Rerun to get/i
    return true if log_content =~ /Please rerun LaTeX/i
    return true if log_content =~ /There were undefined references/i
    return true if log_content =~ /There were undefined citations/i
    return true if log_content =~ /Package rerunfilecheck Warning: File .* has changed/i
    return true if log_content =~ /Package ocgx2 Warning: Rerun/i

    false
  end

  def aux_has_cross_references?(aux_hash)
    aux_hash.match?(/\\(?:newlabel|citation|@writefile)/)
  end

  def count_errors_in_log(st, loga)
    raw = LaTeXUtils.safe_read(loga)
    content = LaTeXUtils.filter_subcommand_noise(raw)
    lines = content.lines

    errcntx = lines.count { |l| l.include?('Error:') || l.match?(/^!\s/) || l.match?(/:\d+:\s+error/i) }
    errcnty = lines.count { |l| l.include?('Undefined control sequence') }
    errcntz = lines.count { |l| l.include?('Runaway argument?') }
    errcnta = lines.count { |l| l.include?('WARN - ') }
    errcntmd = lines.count { |l| l.include?('multiply defined') && l.include?('LaTeX Warning') }

    begin
      FileUtils.mkdir_p('/tmp/sariel')
      File.write('/tmp/sariel/latex_multiply_defined', "#{errcntmd}\n")
    rescue StandardError
      nil
    end

    errcntx + errcnty + errcntz + errcnta + st + errcntmd
  end

  def extract_error_line(err_text)
    clean = err_text.gsub(/\([a-zA-Z0-9_\-]+\)\s*/, '')
    if clean =~ /:(\d+):/
      $1.to_i
    elsif clean =~ /\bl\.(\d+)\b/
      $1.to_i
    elsif clean =~ /(?:at|on|in)?\s*(?:input\s+)?lines?\s*(\d+)/i
      $1.to_i
    else
      0
    end
  end

  def extract_box_severity(box_line)
    if box_line =~ /\(([\d\.]+)pt too (?:wide|high)\)/i
      $1.to_f
    elsif box_line =~ /\(badness (\d+)\)/i
      $1.to_f
    else
      0.0
    end
  end

  def colorize_line_num(str, base_color = nil)
    return str if @options[:emacs]

    if base_color == :cyan
      Rainbow(str).blue.bright.to_s
    else
      Rainbow(str).cyan.bright.to_s
    end
  end

  def highlight_line_numbers(text, base_color, bright: false)
    return text if @options[:emacs]

    pattern = /((?:input\s+)?lines?\s+)(\d+(?:--?\d+)?)|(\bl\.)(\d+)\b|(:)(\d+)(:)/i
    parts = []
    last_pos = 0

    apply_base = lambda do |str|
      r = Rainbow(str).send(base_color)
      bright ? r.bright.to_s : r.to_s
    end

    text.scan(pattern) do
      m = Regexp.last_match
      m_start = m.begin(0)
      m_end = m.end(0)

      parts << apply_base.call(text[last_pos...m_start]) if m_start > last_pos

      if m[1]
        parts << apply_base.call(m[1])
        parts << colorize_line_num(m[2], base_color)
      elsif m[3]
        parts << apply_base.call(m[3])
        parts << colorize_line_num(m[4], base_color)
      elsif m[5]
        parts << apply_base.call(m[5])
        parts << colorize_line_num(m[6], base_color)
        parts << apply_base.call(m[7])
      end
      last_pos = m_end
    end

    parts << apply_base.call(text[last_pos..-1]) if last_pos < text.length
    parts.join
  end

  def format_diagnostic_line(line_str, message, base_color, width: 0, bright_sep: true)
    return message if @options[:emacs]

    str = line_str.to_s
    sep = Rainbow(': ').send(base_color)
    sep_str = bright_sep ? sep.bright.to_s : sep.to_s

    left_side = if str.empty?
                  padding = ' ' * width
                  "#{padding}#{sep_str}"
                else
                  padding = ' ' * [width - str.length, 0].max
                  num_part = colorize_line_num(str, base_color)
                  "#{padding}#{num_part}#{sep_str}"
                end

    left_side + highlight_line_numbers(message, base_color)
  end

  def format_error_block(err_block, line_no, width: 0)
    return err_block.join("\n") if @options[:emacs]

    str = line_no.to_s
    indent = ' ' * (width.positive? ? width + 2 : 2)

    err_block.map.with_index do |l, idx|
      colored = highlight_line_numbers(l, :red, bright: true)
      if idx == 0
        if line_no.positive? && !l.match?(/:#{line_no}:|^\s*#{line_no}:/)
          padding = ' ' * [width - str.length, 0].max
          num_part = colorize_line_num(str, :red)
          sep_str = Rainbow(': ').red.bright.to_s
          "#{padding}#{num_part}#{sep_str}#{colored}"
        elsif width.positive? && !l.match?(/:#{line_no}:|^\s*#{line_no}:/)
          padding = ' ' * width
          sep_str = Rainbow(': ').red.bright.to_s
          "#{padding}#{sep_str}#{colored}"
        else
          colored
        end
      else
        "#{indent}#{colored}"
      end
    end.join("\n")
  end

  def render_diagnostic_item(item, width: 0)
    if item[:err_block]
      format_error_block(item[:err_block], item[:line] || 0, width: width)
    else
      base_color = item[:base_color] || :yellow
      out = format_diagnostic_line(item[:line_str], item[:text], base_color, width: width)
      if @options[:verbose] && item[:extra_lines] && !item[:extra_lines].empty?
        indent = ' ' * (width.positive? ? width + 2 : 2)
        out += "\n" + item[:extra_lines].map do |el|
          @options[:emacs] ? el : "#{indent}#{highlight_line_numbers(el, base_color)}"
        end.join("\n")
      end
      out
    end
  end

  def track_log_file(line, file_stack)
    return if line =~ /^(?:LaTeX|Class|Package|\*)[\s\-A-Za-z0-9]*?[Ww]arning:/
    return if line =~ /^(?:Overfull|Underfull)/ || line =~ /^!\s+/

    file_pattern = /\((?:"([^"]+)"|(\.[\\\/][^\s\(\)]+|[a-zA-Z0-9_\-\.\/]+?\.(?:tex|sty|cls|aux|bbl|bib|dtx|def|ldf|cfg|clo|toc|lof|lot|png|pdf|jpg|eps))\b)/
    opened = line.scan(file_pattern).map { |m| m.compact.first }
    opened.each { |f| file_stack << f }

    closes = line.scan(/\)/).size
    opens = line.scan(/\(/).size
    (closes - opens).times { file_stack.pop if file_stack.size > 1 }
  end

  def diagnostic_boundary_line?(line)
    return true if line.strip.empty?
    return true if line =~ /^(LaTeX|Class|Package|\*) [-A-Za-z0-9]* ?[Ww]arning:/
    return true if line =~ /^(Overfull|Underfull)/
    return true if line =~ /^\[\d+\]/
    return true if line =~ /^!\s+/
    return true if line =~ /^.+:\d+:/
    return true if line =~ /^Runaway argument\?/
    return true if line =~ /^\s*\)/
    return true if line =~ /^\s*\((?:\.[\\\/]|[a-zA-Z0-9_\-\.\/]+?\.(?:tex|sty|cls|aux|bbl|bib))/

    false
  end

  def parse_package_warning(lines, i, file_stack)
    l = lines[i]
    return [nil, i + 1] if l.include?('multiply defined')

    warn_block = [l.strip]
    start_idx = i
    i += 1
    while i < lines.size && !diagnostic_boundary_line?(lines[i])
      warn_block << lines[i].strip
      i += 1
    end

    warn_text = warn_block.join(' ')
    clean_text = warn_text.gsub(/\([a-zA-Z0-9_\-]+\)\s*/, '')
    clean_text = clean_text.gsub(/line (\d+)\s+(\d+)\b/, 'line \1\2')
    line_no = 0
    line_str = ''
    file_name = file_stack.last || "./#{@filename}"
    if clean_text =~ /^([^\s:]+):(\d+):/
      file_name = $1
      line_no = $2.to_i
      line_str = $2
    elsif clean_text =~ /(?:at|on|in)?\s*(?:input\s+)?lines?\s*(\d+)/i
      line_no = $1.to_i
      line_str = $1
    elsif clean_text =~ /:(\d+):/
      line_no = $1.to_i
      line_str = $1
    end

    formatted = format_diagnostic_line(line_str, warn_text, :yellow)
    item = { type: :warn, file: file_name, line: line_no, line_str: line_str, text: warn_text, base_color: :yellow, formatted: formatted, index: start_idx }
    [item, i]
  end

  def parse_box_warning(lines, i, file_stack, verbose)
    l = lines[i]
    start_idx = i
    box_type = "#{$1} \\#{$2}" if l =~ /^(Overfull|Underfull) \\(hbox|vbox)/
    box_type ||= 'Overfull \\hbox'
    box_line = l.strip
    color_m = box_line.start_with?('Overfull') ? :magenta : :cyan
    i += 1
    extra_lines = []
    while i < lines.size && !diagnostic_boundary_line?(lines[i]) && lines[i] !~ /^l\.\d+/
      extra_lines << lines[i].strip
      i += 1
    end

    line_no = 0
    line_str = ''
    if box_line =~ /lines?\s+(\d+(?:--\d+)?)/i
      line_str = $1
      line_no = $1.split('--').first.to_i
    end

    file_name = file_stack.last || "./#{@filename}"
    formatted = format_diagnostic_line(line_str, box_line, color_m)
    if verbose && !extra_lines.empty?
      formatted += "\n" + extra_lines.map { |line| @options[:emacs] ? line : highlight_line_numbers(line, color_m) }.join("\n")
    end

    severity = extract_box_severity(box_line)
    item = {
      type: box_type, file: file_name, line: line_no, line_str: line_str,
      text: box_line, base_color: color_m, extra_lines: extra_lines,
      severity: severity, formatted: formatted, index: start_idx
    }
    [item, i]
  end

  def deduplicate_box_warnings(raw_warnings)
    filtered_warnings = []
    box_groups = {}
    raw_warnings.each do |w|
      if w[:type].is_a?(String) && w[:type] =~ /^(Overfull|Underfull)/ && !w[:line_str].empty?
        key = [w[:file], w[:type], w[:line_str]]
        box_groups[key] ||= []
        box_groups[key] << w
      else
        filtered_warnings << w
      end
    end

    box_groups.each do |_key, items|
      biggest = items.max_by { |item| item[:severity] }
      filtered_warnings << biggest
    end

    filtered_warnings
  end

  def extract_warnings(content, verbose = false)
    raw_warnings = []
    seen_warnings = {}
    lines = content.lines
    file_stack = ["./#{@filename}"]
    i = 0
    while i < lines.size
      l = lines[i]
      track_log_file(l, file_stack)

      if l =~ /^(LaTeX|Class|Package|\*) [-A-Za-z0-9]* ?[Ww]arning:/
        item, next_i = parse_package_warning(lines, i, file_stack)
        if item && !seen_warnings[item[:text]]
          seen_warnings[item[:text]] = true
          raw_warnings << item
        end
        i = next_i
      elsif l =~ /^(Overfull|Underfull) \\(hbox|vbox)/
        item, next_i = parse_box_warning(lines, i, file_stack, verbose)
        raw_warnings << item if item
        i = next_i
      else
        i += 1
      end
    end

    deduplicate_box_warnings(raw_warnings)
  end

  def extract_errors(content)
    errors = []
    clean_content = LaTeXUtils.filter_subcommand_noise(content)
    lines = clean_content.lines
    file_stack = ["./#{@filename}"]
    i = 0
    while i < lines.size
      line = lines[i]
      track_log_file(line, file_stack)

      if line =~ /^!\s*(?:==>\s*)?(?:Emergency stop|Fatal error occurred)/i
        i += 1
        next
      end

      is_err = false
      err_file = nil
      if line =~ /^([^\s:]+):(\d+):\s+(?:(?:LaTeX|Package|Class)\s+Error:|Undefined control sequence|Error:|Runaway argument\?|Missing\s|Extra\s|You can't use|.*error)/i
        is_err = true
        err_file = $1
      elsif line =~ /^!\s+\S+/ ||
            line =~ /^Runaway argument\?/ ||
            line =~ /^Error:\s+/i ||
            (line.include?('multiply defined') && line.include?('LaTeX Warning'))
        is_err = true
      end

      if is_err
        start_idx = i
        err_block = [line]
        i += 1
        while i < lines.size && err_block.size < 6
          curr = lines[i]
          break if curr =~ /^!\s*(?:==>\s*)?(?:Emergency stop|Fatal error occurred)/i
          break if curr =~ /^.+:\d+:\s+(?:(?:LaTeX|Package|Class)\s+Error:|Undefined control sequence|Error:|Runaway argument\?|Missing\s|Extra\s|You can't use|.*error)/i
          break if curr =~ /^!\s+\S+/
          break if curr =~ /^Runaway argument\?/
          break if curr =~ /^(?:LaTeX|Class|Package|\*)[\s\-A-Za-z0-9]*?[Ww]arning:/
          break if curr =~ /^(?:Overfull|Underfull) \\(?:hbox|vbox)/
          break if curr =~ /^\s*\)/
          break if curr =~ /^\s*\((?:\.[\\\/]|[a-zA-Z0-9_\-\.\/]+?\.(?:tex|sty|cls|aux|bbl|bib))/

          err_block << curr
          i += 1
          break if curr =~ /^l\.\d+/
        end

        err_block = err_block.map(&:rstrip).reject(&:empty?)
        err_text = err_block.join("\n")
        line_no = extract_error_line(err_text)
        formatted = format_error_block(err_block, line_no)
        file_name = err_file || file_stack.last || "./#{@filename}"
        errors << { file: file_name, line: line_no, line_str: (line_no > 0 ? line_no.to_s : ''), text: err_text, err_block: err_block, base_color: :red, formatted: formatted, index: start_idx }
      else
        i += 1
      end
    end
    errors
  end

  def overfull_hbox?(item)
    t = item[:type].to_s
    txt = item[:text].to_s
    (t.include?('Overfull') && t.include?('hbox')) || txt =~ /\AOverfull\s+\\hbox/i
  end

  def print_diagnostics_body(warnings, errors, fallback_lines: [])
    overfull_warnings, other_warnings = warnings.partition { |w| overfull_hbox?(w) }

    sorted_other = other_warnings.sort_by { |w| [w[:file] || "./#{@filename}", w[:line] || 0, w[:index] || 0] }
    sorted_overfull = overfull_warnings.sort_by do |w|
      sev = w[:severity] || extract_box_severity(w[:text].to_s)
      [w[:file] || "./#{@filename}", sev.to_f, w[:line] || 0, w[:index] || 0]
    end
    sorted_errors = errors.sort_by { |e| [e[:file] || "./#{@filename}", e[:line] || 0, e[:index] || 0] }

    all_items = sorted_other + sorted_overfull + sorted_errors
    max_width = all_items.map { |item| item[:line_str].to_s.length }.max || 0

    all_sorted = all_items.sort_by do |item|
      [item[:file] || "./#{@filename}", item[:line] || 0, item[:index] || 0]
    end

    current_file = nil
    all_sorted.each do |item|
      item_file = item[:file] || "./#{@filename}"
      if item_file != current_file
        puts ')' if current_file
        puts "(#{item_file}"
        current_file = item_file
      end
      rendered = render_diagnostic_item(item, width: max_width).rstrip
      puts rendered unless rendered.empty?
    end

    if all_sorted.empty? && !fallback_lines.empty?
      puts "(./#{@filename}"
      fallback_lines.each do |l|
        next if l.strip.empty?
        puts @options[:emacs] ? l.strip : highlight_line_numbers(l.strip, :red, bright: true)
      end
      puts ')'
    elsif current_file
      puts ')'
    end

    [sorted_other.size + sorted_overfull.size, sorted_errors.size]
  end

  def report_errors(loga)
    raw = LaTeXUtils.safe_read(loga)
    content = LaTeXUtils.filter_subcommand_noise(raw)

    puts Rainbow("\n===============================================================").red.bright
    puts Rainbow(' ERROR: LaTeX Compilation Failed!').red.bright
    puts Rainbow('===============================================================').red.bright

    warnings = extract_warnings(content, @options[:verbose])
    errors = extract_errors(content)

    fallback = errors.empty? ? content.lines.last(15) : []
    num_warnings, num_errors = print_diagnostics_body(warnings, errors, fallback_lines: fallback)

    puts Rainbow('===============================================================').red.bright
    puts "See #{loga} for full error details."
    errors = [num_errors, count_latex_errors(raw, 1)].max
    warnings = num_warnings
    errors_str = errors > 0 ? Rainbow("Errors: #{errors}").red.bright : Rainbow("Errors: #{errors}").green.bright
    warnings_str = warnings > 0 ? Rainbow("Warnings: #{warnings}").yellow.bright : Rainbow("Warnings: #{warnings}").green.bright
    puts ''
    puts "#{errors_str}, #{warnings_str}"
    exit 1
  end

  def update_target_file(src, dst, update_on_diff: false)
    return unless File.exist?(src)

    if update_on_diff && File.exist?(dst) && dst.end_with?('.pdf') && LaTeXUtils.command_available?('pdftotext')
      txt_src, = Open3.capture2e('pdftotext', '-layout', src, '-')
      txt_dst, = Open3.capture2e('pdftotext', '-layout', dst, '-')
      if txt_src == txt_dst
        puts "\n  \e[37;45m PDF text content unchanged (skipped target overwrite) \e[0m"
        return
      end
    end

    FileUtils.cp(src, dst)
    puts "  Updated target: #{dst}" if update_on_diff
  end

  def collect_diagnostic_counts(new_content)
    cnt_overfull = new_content.scan(/overfull/i).size
    cnt_underfull = new_content.scan(/underfull/i).size
    cnt_bibtex = 0
    cnt_bibtexa = 0
    cnt_bibtexb = 0
    cnt_biberr = 0

    if @biberr && File.exist?(@biberr)
      bib_content = LaTeXUtils.safe_read(@biberr)
      cnt_bibtex = bib_content.scan(/Warning--/i).size
      cnt_bibtexa = bib_content.scan(/Repeated entry---/i).size
      cnt_bibtexb = bib_content.scan(/WARN - /).size
      cnt_biberr = bib_content.scan(/error/i).size
    end

    cnt_undef_cite = 0
    cnt_undef_ref = 0
    cnt_mult_def = 0
    new_content.each_line do |line|
      cnt_undef_cite += 1 if line =~ /citation/i && line =~ /undefined/i
      cnt_undef_ref += 1 if line =~ /reference/i && line =~ /undefined/i && line =~ /page/i
      cnt_mult_def += 1 if line =~ /multiply defined/i && line =~ /label/i
    end

    cbib = cnt_bibtex + cnt_bibtexa + cnt_bibtexb + cnt_biberr
    {
      overfull: cnt_overfull, underfull: cnt_underfull,
      cbib: cbib, biberr: cnt_biberr,
      undef_cite: cnt_undef_cite, undef_ref: cnt_undef_ref, mult_def: cnt_mult_def,
      bib_warns: cnt_bibtex + cnt_bibtexa + cnt_bibtexb
    }
  end

  def print_diagnostic_banner(counts)
    puts '----------------------------------------------------------'
    overfull_s = counts[:overfull] > 0 ? Rainbow("Overfull: #{counts[:overfull]}").magenta : "Overfull: #{counts[:overfull]}"
    underfull_s = counts[:underfull] > 0 ? Rainbow("Underfull: #{counts[:underfull]}").cyan : "Underfull: #{counts[:underfull]}"
    bib_s = counts[:cbib] > 0 ? Rainbow("Bibtex warns/errors: #{counts[:cbib]}").yellow.bright : "Bibtex warns/errors: #{counts[:cbib]}"
    cite_s = counts[:undef_cite] > 0 ? Rainbow("Undef cite: #{counts[:undef_cite]}").red.bright : "Undef cite: #{counts[:undef_cite]}"
    refs_s = counts[:undef_ref] > 0 ? Rainbow("Undef refs: #{counts[:undef_ref]}").red.bright : "Undef refs: #{counts[:undef_ref]}"
    mult_s = counts[:mult_def] > 0 ? Rainbow("Lab multi-def: #{counts[:mult_def]}").red.bright : "Lab multi-def: #{counts[:mult_def]}"
    puts "#{overfull_s} | #{underfull_s} | #{bib_s} | #{cite_s} | #{refs_s} | #{mult_s}"
    puts '----------------------------------------------------------'
  end

  def append_bib_diagnostics!(warn_items, err_items)
    return unless @biberr && File.exist?(@biberr)

    bib_content = LaTeXUtils.safe_read(@biberr)
    bib_content.each_line.with_index do |bl, bidx|
      if bl =~ /Repeated entry---/i || bl =~ /Warning--/i || bl =~ /WARN - /
        line_str = bl =~ /line\s+(\d+)/i ? $1 : ''
        formatted = format_diagnostic_line(line_str, bl.strip, :yellow)
        warn_items << { file: './bibliography', line: line_str.to_i, line_str: line_str, text: bl.strip, formatted: formatted, index: 100000 + bidx }
      elsif bl =~ /couldn't open/i || bl =~ /error/i
        formatted = @options[:emacs] ? bl.strip : highlight_line_numbers(bl.strip, :red, bright: true)
        err_items << { file: './bibliography', line: 0, text: bl.strip, formatted: formatted, index: 100000 + bidx }
      end
    end
  end

  def analyze_output
    pdferr = find_last_latex_log
    if @options[:score]
      output_score(pdferr, 0)
      return
    end

    new_content = LaTeXUtils.safe_read(pdferr)
    counts = collect_diagnostic_counts(new_content)
    total_diag = counts[:cbib] + counts[:undef_cite] + counts[:undef_ref] + counts[:mult_def] + counts[:overfull] + counts[:underfull]

    errors = count_latex_errors(new_content, 0) + counts[:biberr]
    warnings = count_latex_warnings(new_content) + counts[:bib_warns]

    if total_diag > 0 || errors > 0
      print_diagnostic_banner(counts)
      clean_content = LaTeXUtils.filter_subcommand_noise(new_content)
      warn_items = extract_warnings(clean_content, @options[:verbose])
      err_items = extract_errors(clean_content)

      append_bib_diagnostics!(warn_items, err_items) if counts[:cbib] > 0

      num_warnings, num_errors = print_diagnostics_body(warn_items, err_items)
      warnings = num_warnings
      errors = [num_errors, errors].max
    end

    return unless errors > 0 || warnings > 0

    errors_str = errors > 0 ? Rainbow("Errors: #{errors}").red.bright : Rainbow("Errors: #{errors}").green.bright
    warnings_str = warnings > 0 ? Rainbow("Warnings: #{warnings}").yellow.bright : Rainbow("Warnings: #{warnings}").green.bright
    puts ''
    puts "#{errors_str}, #{warnings_str}"

    if @options[:werror] && warnings > 0
      puts Rainbow("\n[Werror] Warnings treated as fatal errors.").red.bright
      exit 1
    end
  end

  def find_last_latex_log
    %w[_3 _2 _1].each do |s|
      candidate = "#{@pdferr}#{s}"
      return candidate if File.exist?(candidate)
    end
    @pdferr
  end

  def count_latex_errors(content, status = 0)
    errors = 0
    clean_content = LaTeXUtils.filter_subcommand_noise(content)
    clean_content.each_line do |line|
      next if line =~ /^!\s*(?:==>\s*)?(?:Emergency stop|Fatal error occurred)/i

      if line =~ /^!\s+\S+/ ||
         line =~ /^.+:\d+:\s+(?:(?:LaTeX|Package|Class)\s+Error:|Undefined control sequence|Error:|Runaway argument\?|Missing\s|Extra\s|You can't use)/i ||
         line =~ /^.+:\d+:\s+.*error/i ||
         line =~ /^Error:\s+/i ||
         (line.include?('multiply defined') && line.include?('LaTeX Warning'))
        errors += 1
      end
    end
    errors = 1 if errors == 0 && status.to_i > 0
    errors
  end

  def count_latex_warnings(content)
    warnings = 0
    content.each_line do |line|
      next if line.include?('multiply defined') && line.include?('LaTeX Warning')

      if line =~ /^(?:LaTeX|Class|Package|\*)[\s\-A-Za-z0-9]*?[Ww]arning:/ ||
         line =~ /^.+:\d+:\s+warning:/i ||
         line =~ /^Warning:\s+/i ||
         line =~ /^(?:Overfull|Underfull) \\(?:hbox|vbox)/
        warnings += 1
      end
    end
    warnings
  end

  def output_score(last_log_path = nil, status = 0)
    last_log_path ||= find_last_latex_log
    content = LaTeXUtils.safe_read(last_log_path)
    errors = count_latex_errors(content, status)
    warnings = count_latex_warnings(content)
    out = @orig_stdout || $stdout
    errors_str = errors > 0 ? Rainbow("Errors: #{errors}").red.bright : Rainbow("Errors: #{errors}").green.bright
    warnings_str = warnings > 0 ? Rainbow("Warnings: #{warnings}").yellow.bright : Rainbow("Warnings: #{warnings}").green.bright
    out.puts "#{errors_str}, #{warnings_str}"
  end
end

class LatexPackager
  attr_reader :builder, :filename, :bfilename, :bdir, :options

  def initialize(builder)
    @builder = builder
    @filename = builder.filename
    @bfilename = builder.bfilename
    @bdir = builder.bdir
    @options = builder.options
  end

  def package!
    if @bdir != '.'
      Dir.chdir(@bdir) { do_package }
    else
      do_package
    end
  end

  private

  def do_package
    fls_path = "junk/#{@bfilename}.fls"
    unless File.exist?(fls_path)
      puts "==> Compiling #{@filename} to collect dependencies for zip..."
      @builder.run!
    end

    deps = collect_fls_dependencies(fls_path)
    fig_sources = discover_figure_sources(deps[:figures])
    zip_filename = @options[:zip_name] || "#{@bfilename}.zip"

    stage_and_create_zip(zip_filename, deps, fig_sources)
    puts Rainbow("==> Created portable zip: #{zip_filename}").green.bright

    verify_archive!(zip_filename) if @options[:verify]
    zip_filename
  end

  def collect_fls_dependencies(fls_path)
    content = LaTeXUtils.safe_read(fls_path)
    styles = []
    figures = []
    tex_inputs = []

    content.each_line do |line|
      next unless line.start_with?('INPUT ')

      path = line.sub(/^INPUT\s+/, '').strip
      next if path.empty? || path.start_with?('junk/') || system_texmf_file?(path)

      clean_path = normalize_dep_path(path)
      next if clean_path == @filename || clean_path == "#{@bfilename}.pdf"

      case File.extname(clean_path).downcase
      when '.sty', '.cls', '.clo', '.def', '.bbx', '.cbx'
        styles << clean_path
      when '.pdf', '.png', '.jpg', '.jpeg', '.eps', '.mps'
        figures << clean_path unless clean_path.end_with?("#{@bfilename}.pdf")
      when '.tex'
        tex_inputs << clean_path
      end
    end

    { styles: styles.uniq, figures: figures.uniq, tex_inputs: tex_inputs.uniq }
  end

  def system_texmf_file?(path)
    path =~ %r{/(texmf-dist|texmf-var|texlive/20\d\d|texlive/debian|share/texlive)/}
  end

  def normalize_dep_path(path)
    return path unless path.start_with?('./')

    path.sub(%r{^\./}, '')
  end

  def discover_figure_sources(figures)
    valid_exts = @options[:fig_sources] || ['.fig', '.ipe', '.svg', '.asy', '.gp', '.gnuplot', '.py', '.R']
    discovered = []

    figures.each do |fig|
      dir = File.dirname(fig)
      stem = fig.sub(/\.[^.]+\z/, '')

      valid_exts.each do |ext|
        cand = "#{stem}#{ext}"
        discovered << cand if File.file?(cand)
      end

      base_stem = stem.sub(/[-_]([0-9]+|[a-z]|fig[0-9]+)\z/i, '')
      if base_stem != stem
        valid_exts.each do |ext|
          cand = "#{base_stem}#{ext}"
          discovered << cand if File.file?(cand)
        end
      end

      Dir.glob(File.join(dir, '*.isy')).each do |isy|
        discovered << isy if File.file?(isy)
      end
    end

    discovered.uniq.reject do |p|
      p =~ %r{(^|/)(bak|old|old_ipe)/} || p.end_with?('.bak', '~')
    end
  end

  def stage_and_create_zip(zip_filename, deps, fig_sources)
    unless system('which zip > /dev/null 2>&1')
      warn Rainbow("[ERROR] 'zip' command not found in PATH! Cannot create archive.").red.bright
      return
    end

    Dir.mktmpdir('latex_it_stage_') do |stage_dir|
      copy_target_outputs(stage_dir)
      stage_main_tex(stage_dir, !deps[:styles].empty?)

      deps[:tex_inputs].each { |f| copy_preserving_path(f, stage_dir) if File.file?(f) }
      stage_styles(deps[:styles], stage_dir)

      (deps[:figures] + fig_sources).uniq.each do |f|
        copy_preserving_path(f, stage_dir) if File.file?(f)
      end

      extra_files = Array(@options[:extra_files]).flat_map { |g| Dir.glob(g).empty? ? [g] : Dir.glob(g) }
      extra_files.uniq.each do |f|
        copy_preserving_path(f, stage_dir) if File.exist?(f)
      end

      zip_abs = File.expand_path(zip_filename)
      FileUtils.rm_f(zip_abs)
      Dir.chdir(stage_dir) do
        system('zip', '-q', '-r', zip_abs, '.')
      end
    end
  end

  def copy_target_outputs(stage_dir)
    pdf_source = File.file?("#{@bfilename}.pdf") ? "#{@bfilename}.pdf" : "junk/#{@bfilename}.pdf"
    FileUtils.cp(pdf_source, File.join(stage_dir, "#{@bfilename}.pdf")) if File.file?(pdf_source)

    bbl_source = File.file?("#{@bfilename}.bbl") ? "#{@bfilename}.bbl" : "junk/#{@bfilename}.bbl"
    if File.file?(bbl_source) && LaTeXUtils.bbl_has_entries?(bbl_source)
      FileUtils.cp(bbl_source, File.join(stage_dir, "#{@bfilename}.bbl"))
    end
  end

  def stage_main_tex(stage_dir, has_styles = false)
    dest_path = File.join(stage_dir, @filename)
    FileUtils.mkdir_p(File.dirname(dest_path))

    content = LaTeXUtils.safe_read(@filename)
    if @options[:inject_styles] && has_styles && !content.include?('input@path')
      injection = "\\makeatletter\n\\def\\input@path{{styles/}{./}}\n\\makeatother\n"
      injected_content = inject_into_tex(content, injection)
      File.write(dest_path, injected_content)
    else
      File.write(dest_path, content)
    end
  end

  def inject_into_tex(content, injection)
    lines = content.lines
    insert_idx = lines.find_index { |l| l =~ /^\s*\\(documentclass|RequirePackage|input)/ } || 0
    lines.insert(insert_idx, injection).join
  end

  def stage_styles(styles, stage_dir)
    if @options[:inject_styles]
      dest_dir = File.join(stage_dir, 'styles')
      FileUtils.mkdir_p(dest_dir)
      styles.each do |style|
        FileUtils.cp(style, File.join(dest_dir, File.basename(style))) if File.file?(style)
      end
    else
      styles.each do |style|
        copy_preserving_path(style, stage_dir) if File.file?(style)
      end
    end
  end

  def copy_preserving_path(src, dest_root)
    return unless File.exist?(src)

    cwd = Dir.pwd
    expanded = File.expand_path(src)
    rel_path = if expanded.start_with?(cwd + '/')
                 expanded.sub(cwd + '/', '')
               else
                 File.basename(src)
               end

    dest = File.join(dest_root, rel_path)
    FileUtils.mkdir_p(File.dirname(dest))
    FileUtils.cp_r(src, dest)
  end

  def verify_archive!(zip_filename)
    zip_abs = File.expand_path(zip_filename)
    puts Rainbow("==> Verifying archive portability in isolated sandbox...").cyan.bright

    unless system('which unzip > /dev/null 2>&1')
      warn Rainbow("[ERROR] 'unzip' command not found in PATH! Cannot verify archive.").red.bright
      return false
    end

    Dir.mktmpdir('latex_it_verify_') do |tmpdir|
      unzip_out, unzip_stat = Open3.capture2e('unzip', '-q', zip_abs, '-d', tmpdir)
      unless unzip_stat.success?
        warn Rainbow("[FAIL] Failed to extract #{zip_filename}: #{unzip_out}").red.bright
        return false
      end

      bundled_pdf = File.join(tmpdir, "#{@bfilename}.pdf")
      backup_pdf = File.join(tmpdir, "#{@bfilename}.pdf.bundled")
      FileUtils.mv(bundled_pdf, backup_pdf) if File.file?(bundled_pdf)

      ruby_bin = RbConfig.ruby
      script_bin = File.expand_path($PROGRAM_NAME)
      cmd = [ruby_bin, script_bin, '--env-free', @filename]

      compile_out, compile_stat = Open3.capture2e(*cmd, chdir: tmpdir)
      new_pdf = File.join(tmpdir, "#{@bfilename}.pdf")

      if compile_stat.success? && File.file?(new_pdf)
        verify_pdf_diff(backup_pdf, new_pdf)
        puts Rainbow("[VERIFIED] Archive successfully verified: self-contained and compiles in clean environment.").green.bright
        true
      else
        warn Rainbow("[FAIL] Verification failed! Document did not compile in clean environment.").red.bright
        warn compile_out
        false
      end
    end
  end

  def verify_pdf_diff(orig_pdf, new_pdf)
    return unless File.file?(orig_pdf) && File.file?(new_pdf)
    return unless system('which pdftotext > /dev/null 2>&1')

    t1, = Open3.capture2('pdftotext', '-layout', orig_pdf, '-')
    t2, = Open3.capture2('pdftotext', '-layout', new_pdf, '-')
    if t1 == t2
      puts Rainbow(" -- Text layout exact match confirmed between bundled PDF and test build.").green
    else
      warn Rainbow(" -- Note: Minor visual layout differences detected between bundled and sandbox PDF.").yellow
    end
  end
end

# ------------------------------------------------------------------------------
# CLI Option Parsing
# ------------------------------------------------------------------------------

# Direct execution if invoked via symlink or binary
return unless __FILE__ == $PROGRAM_NAME || (File.exist?($PROGRAM_NAME) && File.identical?(__FILE__, $PROGRAM_NAME))

prog_name = File.basename($PROGRAM_NAME)
if prog_name == 'latex_file_in_dir'
  dir = ARGV[0] || '.'
  puts LaTeXUtils.find_main_latex_file(dir)
  exit 0
elsif %w[latex_clean clean_latex latex-clean].include?(prog_name)
  if ARGV.include?('-h') || ARGV.include?('--help')
    puts "Usage: #{prog_name} [directory...]"
    puts 'Clean all LaTeX auxiliary and junk files in the specified directory (default: current directory).'
    exit 0
  end
  dirs = ARGV.empty? ? ['.'] : ARGV
  dirs.each do |d|
    target = File.directory?(d) ? d : File.dirname(d)
    LaTeXUtils.clean_directory(target)
  end
  exit 0
end

symlink_engine = if %w[ll llua lualatex_l].include?(prog_name)
                   'lualatex'
                 elsif %w[lp pdflatex_l pdflatex].include?(prog_name)
                   LaTeXUtils.check_engine!('pdflatex')
                 end

is_lw = (File.basename($PROGRAM_NAME) == 'lw')
is_env_free = %w[pdflatex_env_free latex_env_free bibtex_env_free].include?(prog_name)

extra_cli_files = []
if (sep_idx = ARGV.index('--'))
  extra_cli_files = ARGV[(sep_idx + 1)..].flat_map { |f| Dir.glob(f).empty? ? [f] : Dir.glob(f) }
  ARGV.slice!(sep_idx..)
end

cfg = LaTeXConfig.load_merged_config

options = {
  engine: symlink_engine || cfg['engine'],
  clean: false,
  single_pass: false,
  fast: is_lw || cfg['fast'] == true,
  update_on_diff: cfg['update_on_diff'] == true,
  bib: cfg['bib'],
  passes: (cfg['passes'] || 3).to_i.clamp(1, 3),
  time: cfg['time'] == true,
  lock: cfg['lock'] == true,
  score: false,
  color: cfg['color'],
  no_env: is_env_free,
  verbose: false,
  emacs: cfg['emacs'] == true,
  werror: cfg['werror'] == true,
  deps: false,
  zip: false,
  verify: false,
  zip_name: nil,
  inject_styles: cfg.dig('zip', 'inject_styles') == true,
  fig_sources: cfg.dig('zip', 'fig_sources') || ['.fig', '.ipe', '.svg', '.asy', '.gp', '.gnuplot', '.py', '.R'],
  extra_files: (Array(cfg.dig('zip', 'include')) + extra_cli_files).uniq
}

ARGV.map! do |arg|
  case arg
  when '-score' then '--score'
  when '-no-env' then '--no-env'
  when '-env-free' then '--env-free'
  when '-envfree' then '--envfree'
  when '-emacs' then '--emacs'
  when '-deps' then '--deps'
  when '-werror', '-Werror' then '--werror'
  when '-zip' then '--zip'
  when '-verify' then '--verify'
  else arg
  end
end

parser = OptionParser.new do |opts|
  opts.banner = 'Usage: l [options] [document.tex]'
  opts.separator ''
  opts.separator 'Compilation Options:'

  opts.on('-m', '--main', '--find-main', '--file', 'Print the detected main LaTeX file and exit') do
    dir = ARGV[0] || '.'
    puts LaTeXUtils.find_main_latex_file(dir)
    exit 0
  end

  opts.on('-C', '--clean-only', 'Clean auxiliary and junk files in directory and exit without building') do
    dir = ARGV[0] || '.'
    target = File.directory?(dir) ? dir : File.dirname(dir)
    LaTeXUtils.clean_directory(target)
    exit 0
  end

  opts.on('--fast', 'Fast incremental mode: reuse aux files and only run subsequent passes/biber/bibtex if needed') do
    options[:fast] = true
  end

  opts.on('-e', '--engine ENGINE', 'LaTeX compiler: xelatex (default), lualatex') do |v|
    LaTeXUtils.check_engine!(v)
    options[:engine] = LaTeXUtils.normalize_engine(v)
  end

  opts.on('--lua', '--lualatex', 'Shortcut for --engine=lualatex') do
    options[:engine] = 'lualatex'
  end

  opts.on('--xe', '--xelatex', 'Shortcut for --engine=xelatex (default)') do
    options[:engine] = 'xelatex'
  end

  opts.on('--pdf', 'Generate PDF output (default behavior)') do
    # No-op: output is already PDF using the default engine (xelatex)
  end

  opts.on('--pdflatex', 'Shortcut for --engine=pdflatex (rejected)') do
    LaTeXUtils.check_engine!('pdflatex')
  end

  opts.on('-u', '--single-pass', '--quick', 'Perform a single LaTeX run only (no BibTeX/Biber, no extra passes)') do
    options[:single_pass] = true
    options[:passes] = 1
    options[:bib] = false
  end

  opts.on('-d', '--diff', '--update-on-diff', 'Only replace target PDF if text content changed') do
    options[:update_on_diff] = true
  end

  opts.on('-c', '--clean', 'Clean temporary build files (junk/, .bbl, .aux) before building') do
    options[:clean] = true
  end

  opts.on('-b', '--[no-]bib', 'Force or skip BibTeX pass (default: auto-detect)') do |v|
    options[:bib] = v
  end

  opts.on('-n', '--passes NUM', Integer, 'Number of compilation passes (1-3, default: 3)') do |v|
    options[:passes] = v.clamp(1, 3)
  end

  opts.on('-T', '--time', 'Show execution time diagnostics per pass') do
    options[:time] = true
  end

  opts.on('-t', '--verify', '--test', 'Verify self-contained portability of generated zip in /tmp sandbox') do
    options[:verify] = true
    options[:zip] = true
  end

  opts.on('-z', '--zip', 'Create self-contained portable zip archive of paper') do
    options[:zip] = true
  end

  opts.on('--zip-name NAME', 'Specify custom output name for zip archive') do |v|
    options[:zip] = true
    options[:zip_name] = v
  end

  opts.on('--[no-]inject-styles', 'Enable or disable isolating harvested styles into styles/ and injecting \input@path') do |v|
    options[:inject_styles] = v
  end

  opts.on('--init-config', 'Create a local .l.jsonc configuration template in the current directory and exit') do
    LaTeXConfig.create_local_template!('.')
    exit 0
  end

  opts.on('--[no-]color', 'Enable or disable colored terminal output (default: auto)') do |v|
    options[:color] = v
  end

  opts.on('--lock', 'Enable lockfile concurrency protection') do
    options[:lock] = true
  end

  opts.on('-s', '--score', '[-score] Suppress stdout and output error/warning count from the last LaTeX run') do
    options[:score] = true
  end

  opts.on('--no-env', '--env-free', '--envfree', '[-no-env, -env-free] Reset environment variables used by LaTeX/BibTeX/Biber') do
    options[:no_env] = true
  end

  opts.on('--emacs', 'Format warnings/errors for Emacs AUCTeX integration (suppress line prefixes)') do
    options[:emacs] = true
  end

  opts.on('-v', '--verbose', 'Verbose output (e.g. show box text snippets)') do
    options[:verbose] = true
  end

  opts.on('-W', '--werror', '[-Werror] Treat compilation warnings as fatal errors and exit with non-zero code') do
    options[:werror] = true
  end

  opts.on('-M', '--deps', 'Print Makefile dependency rule for the document and exit') do
    options[:deps] = true
  end

  opts.on('-V', '--version', 'Show version') do
    puts "l #{VERSION}"
    exit 0
  end

  opts.on('-h', '--help', 'Show this help message') do
    puts opts
    exit 0
  end
end

parser.parse!

Rainbow.enabled = false if options[:emacs] && options[:color].nil?
Rainbow.enabled = options[:color] unless options[:color].nil?

LaTeXUtils.reset_latex_environment! if options[:no_env]

# Target file resolution and execution
targets = ARGV.empty? ? [LaTeXUtils.find_main_latex_file] : ARGV

targets.each do |target|
  builder = LatexBuilder.new(target, options)
  builder.run!
  if options[:zip] || options[:verify]
    packager = LatexPackager.new(builder)
    packager.package!
  end
end
