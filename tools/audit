def parse_cli_options
  options = {
    profile: 'systems',
    backend: ENV.fetch('AUDIT_BACKEND', 'auto'),
    tier: ENV.fetch('AUDIT_TIER', 'standard'),
    model: ENV['AUDIT_MODEL'],
    all_files: false,
    include_tests: false,
    target: nil
  }

  parser = OptionParser.new do |opts|
    opts.banner = 'Usage: tools/audit [options] [files/directories...]'

    opts.on('-p', '--profile PROFILE', 'Audit profile (systems|security|correctness|resilience|performance|cli|random, default: systems)') do |p|
      options[:profile] = p
    end

    opts.on('-b', '--backend BACKEND', 'Execution backend (auto|gemini|claude|codex|openai_api, default: auto)') do |b|
      options[:backend] = b.downcase
    end

    opts.on('-t', '--tier TIER', 'Model capability tier (tier0|standard|deep, default: standard)') do |t|
      options[:tier] = t.downcase
    end

    opts.on('-m', '--model MODEL', 'Explicit model identifier override') do |m|
      options[:model] = m
    end

    opts.on('--all-files', 'Audit all source files without profile-specific lens pruning') do
      options[:all_files] = true
    end

    opts.on('--include-tests', 'Include test files/modules in audit payload (default: excluded)') do
      options[:include_tests] = true
    end

    opts.on('-l', '--list-profiles', 'List available audit profiles and descriptions') do
      print_profile_list
      exit 0
    end

    opts.on('-v', '--version', 'Show version and exit') do
      puts "audit v#{VERSION}"
      exit 0
    end

    opts.on('-h', '--help', 'Show this help message') do
      puts opts
      exit 0
    end
  end

  options[:target] = parser.parse(ARGV)
  options
end

def print_profile_list
  puts "\nAvailable Audit Profiles:"
  lang = detect_project_language
  profiles = PROFILES_BY_LANG[lang] || PROFILES_BY_LANG[:generic]
  profiles.each do |key, prof|
    puts "  * #{key.ljust(12)} - #{prof[:name]}"
    puts "    #{prof[:description]}"
  end
  puts "  * random       - Randomly pick one of the above profiles\n\n"
end

def project_profile_override(profile_key)
  candidates = [
    File.join(REPO_ROOT, 'tools', 'profiles', "#{profile_key}.md"),
    File.join(REPO_ROOT, '.audit', 'profiles', "#{profile_key}.md"),
    File.join(REPO_ROOT, '.audit', "#{profile_key}.md")
  ]
  match = candidates.find { |p| File.file?(p) }
  match ? File.read(match).strip : nil
end

def resolve_profile(requested, lang)
  profiles = PROFILES_BY_LANG[lang] || PROFILES_BY_LANG[:generic]
  key, info = if requested == 'random'
                chosen = profiles.keys.sample
                warn "Profile selected randomly: #{chosen} (#{profiles[chosen][:name]})"
                [chosen, profiles[chosen].dup]
              elsif profiles.key?(requested)
                [requested, profiles[requested].dup]
              else
                warn "Unknown profile '#{requested}'. Falling back to 'systems'."
                ['systems', profiles['systems'].dup]
              end

  override = project_profile_override(key)
  if override
    info[:mandate] = "#{info[:mandate]}\n\nProject Specific Mandate Focus:\n#{override}"
  end
  [key, info]
end

def resolve_backend(backend_opt, tier_opt, profile_key)
  has_claude = system('which claude > /dev/null 2>&1')
  has_codex = system('which codex > /dev/null 2>&1')
  has_api = !ENV['OPENAI_API_KEY'].to_s.strip.empty?
  has_gemini = system('which bws > /dev/null 2>&1')

  return :gemini if tier_opt == 'tier0' && %w[auto gemini flash].include?(backend_opt)

  case backend_opt
  when 'gemini', 'flash' then has_gemini ? :gemini : abort_missing('gemini', 'bws or agy-run-wild missing')
  when 'claude'          then has_claude ? :claude : abort_missing('claude', 'claude CLI missing')
  when 'codex'           then has_codex  ? :codex  : abort_missing('codex', 'codex CLI missing')
  when 'openai_api', 'api' then has_api  ? :openai_api : abort_missing('openai_api', 'OPENAI_API_KEY not set')
  when 'auto'            then select_auto_backend(profile_key, has_claude, has_codex, has_api, has_gemini)
  else
    warn "Unknown backend '#{backend_opt}'. Defaulting to auto selection."
    resolve_backend('auto', tier_opt, profile_key)
  end
end

def select_auto_backend(profile_key, has_claude, has_codex, has_api, has_gemini)
  preferred = PROFILE_BACKEND_AFFINITY.fetch(profile_key, :claude)
  return :claude if preferred == :claude && has_claude
  return :codex if preferred == :codex && has_codex
  return :claude if has_claude
  return :codex if has_codex
  return :gemini if has_gemini
  return :openai_api if has_api

  abort_missing('auto', 'Neither claude, codex, bws, nor OPENAI_API_KEY is available.')
end

def abort_missing(backend, msg)
  warn "Error [backend: #{backend}]: #{msg}"
  exit 1
end

def resolve_model(backend, tier, explicit_model)
  return explicit_model if explicit_model && !explicit_model.strip.empty?

  case backend
  when :gemini then 'gemini-3.8-flash-high'
  when :claude then %w[deep tier2].include?(tier) ? 'opus' : 'sonnet'
  when :codex  then ENV.fetch('CODEX_MODEL', 'gpt-5.6-sol')
  when :openai_api then ENV.fetch('OPENAI_MODEL', %w[deep tier2].include?(tier) ? 'o3-mini' : 'gpt-4o')
  end
end

def strip_test_code(code, lang)
  return code unless lang == :rust

  idx = code.index(/\n\s*#\[cfg\(test\)\]/)
  idx ? (code[0...idx] + "\n") : code
end

def filter_files_for_profile(files, profile_key)
  patterns = case profile_key
             when 'cli' then /cli|cmd|tui|keys|flags|subcommand|command|opt/i
             when 'resilience' then /net|http|fetch|client|remote|worker|download|transport|cache|repair/i
             when 'security' then /auth|secret|token|perm|sanitize|exec|path|crypt|quarantine|safe/i
             when 'systems' then /lock|sync|proc|batch|queue|store|db|state|file|atomic|engine|build/i
             when 'performance' then /cache|buf|format|parse|chunk|transcribe|audio|time|bench/i
             end
  return files unless patterns

  scoped = files.select { |f| File.basename(f) =~ patterns }
  scoped.empty? ? files : scoped
end

def test_file?(path, lang)
  base = File.basename(path)
  case lang
  when :go   then base.end_with?('_test.go')
  when :rust then base.end_with?('_test.rs') || base == 'tests.rs'
  when :ruby then base.start_with?('test_') || base.end_with?('_test.rb') || path.include?('/test/')
  else base =~ /test/i
  end
end

def ruby_source_file?(path)
  return true if path.end_with?('.rb')
  return false unless File.file?(path) && File.executable?(path)

  first_line = File.open(path, &:gets).to_s rescue ''
  first_line.start_with?('#!/usr/bin/env ruby') || first_line.start_with?('#!/usr/bin/ruby')
end

def candidate_files_for_path(path, lang)
  if File.file?(path)
    [path]
  elsif File.directory?(path)
    case lang
    when :rust then Dir.glob(File.join(path, '**', '*.rs'))
    when :go   then Dir.glob(File.join(path, '**', '*.go'))
    when :ruby
      all = Dir.glob(File.join(path, '**', '*'))
      all.select { |f| ruby_source_file?(f) }
    else Dir.glob(File.join(path, '**', '*.*'))
    end
  else
    Dir.glob(path)
  end
end

def ignored_audit_path?(path)
  ignored = %w[/.work/ /vendor/ /target/ /junk/ /.bws/ /.git/ /node_modules/]
  ignored.any? { |ig| path.include?(ig) }
end

def resolve_target_files(args, profile_key, all_files, backend, lang, include_tests: false)
  raw_files = args.flat_map { |p| candidate_files_for_path(p, lang) }.uniq
  files = raw_files.select { |f| File.file?(f) && !ignored_audit_path?(f) }
  files = files.reject { |f| test_file?(f, lang) } unless include_tests

  if !all_files && backend != :gemini && files.size > 50
    files = filter_files_for_profile(files, profile_key)
  end

  files
end

