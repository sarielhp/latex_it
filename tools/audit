  elsif lang == :ruby && Dir.exist?(File.join(REPO_ROOT, 'lib'))
    pname = File.basename(REPO_ROOT)
    bin_file = [File.join(REPO_ROOT, pname), File.join(REPO_ROOT, 'bin', pname), File.join(REPO_ROOT, 'exe', pname)].find { |f| File.file?(f) }
    [File.join(REPO_ROOT, 'lib'), bin_file].compact
  else
    [REPO_ROOT]
  end
end

def build_source_payload(files, lang, include_tests)
  files.map do |file|
    rel_path = file.sub(%r{^#{Regexp.escape(REPO_ROOT)}/}, '')
    content = File.read(file)
    content = strip_test_code(content, lang) unless include_tests
    "// --- FILE: #{rel_path} ---\n#{content}\n"
  end.join("\n")
end

def collect_payload(args, profile_key: nil, backend: nil, all_files: false, include_tests: false, lang: :generic)
  if args.empty? && $stdin.stat.pipe?
    return ['diff', $stdin.read]
  end

  targets = args.empty? ? default_search_path(lang) : args
  files = resolve_target_files(targets, profile_key, all_files, backend, lang, include_tests: include_tests)
  if files.empty?
    puts 'NO CRITICAL DEFECTS FOUND (No matching files found).'
    exit 0
  end

  ['source code', build_source_payload(files, lang, include_tests)]
end

def developer_prompt(profile_key, profile_info, lang)
  lang_label = { go: 'Go', rust: 'Rust', ruby: 'Ruby' }.fetch(lang, 'Systems')
  linter_note = case lang
                when :go   then 'Assume all code passes go vet and staticcheck. Do not comment on trivial style preferences or hypothetical concurrency issues on single-threaded paths.'
                when :rust then 'Assume all code passes cargo clippy with 0 warnings. Do not comment on trivial style preferences.'
                when :ruby then 'Assume all code compiles cleanly under ruby -cw and passes unit test suites. Do not comment on trivial style preferences or hypothetical concurrency issues on single-threaded paths.'
                else 'Assume all code strictly compiles and linters pass cleanly.'
                end

  <<~PROMPT
    You are a Principal Systems Engineer and #{lang_label} code auditor conducting a rigorous, objective, and evidence-based code review.
    Audit Lens: #{profile_info[:name]} (#{profile_key})

    #{linter_note}

    Your mandate is to detect deep architectural, domain, and systems defects within your specific focus area:
    #{profile_info[:mandate]}

    Evidence & Severity Rules:
    1. Realistic Evidence Required: Every finding must demonstrate a concrete, realistic input sequence or runtime condition triggering the failure. Do not manufacture non-issues or flag purely theoretical risks.
    2. Severity Anchors:
       - Critical: Arbitrary command execution, data loss or silent file corruption, infinite compiler loops/hangs, crashes in standard workflows.
       - Major: Broken multi-pass convergence, incorrect engine selection, intermediate files leaking out of junk/ isolation, silent error swallowing.
       - Moderate: Edge case error handling, missing process timeout, unnecessary allocation churn in hot loops.

    Review Format:
    For every valid issue found, output:
    [SEVERITY]: Critical, Major, or Moderate
    [LOCATION]: File path and exact line/block reference
    [ROOT CAUSE]: Technical explanation of invariant breakdown
    [FAILURE TRACE]: Concrete sequence, input, or conditions required to trigger the bug
    [REMEDIATION]: Minimal, idiomatic code snippet resolving the defect

    If no genuine defects exist for this focus area, return: "NO CRITICAL DEFECTS FOUND." Do not manufacture non-issues.
  PROMPT
end

def execute_cli_capture(cmd, input_payload)
  stdout, stderr, status = Open3.capture3(*cmd, stdin_data: input_payload)
  if status.success?
    puts stdout
  else
    warn stderr unless stderr.strip.empty?
    exit status.exitstatus || 1
  end
end

def audit_via_claude(dev_prompt, input_payload, payload_type, profile_key, model, tier, lang)
  warn "Auditing via Claude CLI (#{model}, tier: #{tier}) [Profile: #{profile_key}]..."
  cmd = [
    'claude',
    '-p', "Review the following #{lang.to_s.capitalize} #{payload_type}:",
    '--system-prompt', dev_prompt,
    '--tools', '',
    '--no-session-persistence',
    '--model', model
  ]
  execute_cli_capture(cmd, input_payload)
end

def audit_via_codex(dev_prompt, input_payload, payload_type, profile_key, model, tier, lang)
  warn "Auditing via Codex CLI (#{model}, tier: #{tier}) [Profile: #{profile_key}]..."
  cmd = ['codex', 'exec', '-s', 'read-only', '--ephemeral', '--color', 'never']
  cmd += ['-m', model] if model && model != 'default'
  cmd << "#{dev_prompt}\n\nReview the following #{lang.to_s.capitalize} #{payload_type}:"
  execute_cli_capture(cmd, input_payload)
end

def execute_api_post_with_retry(http, req, max_retries = 3)
  attempt = 0
  loop do
    attempt += 1
    resp = http.request(req) rescue nil
    return resp if resp&.is_a?(Net::HTTPSuccess)
    return resp if attempt >= max_retries || (resp && !%w[429 500 502 503 504].include?(resp.code))

    delay = (2**attempt) + rand(0.5..1.5)
    warn "⚠️ Transient API error (#{resp ? resp.code : 'timeout'}). Retrying in #{delay.round(1)}s..."
    sleep delay
  end
end

def audit_via_api(api_key, dev_prompt, input_payload, payload_type, profile_key, model, tier, lang)
  reasoning_effort = ENV.fetch('REASONING_EFFORT', %w[deep tier2].include?(tier) ? 'high' : 'medium')
  warn "Auditing via OpenAI API (#{model}, tier: #{tier}) [Profile: #{profile_key}]...\n"
  fence = { go: 'go', rust: 'rust', ruby: 'ruby' }.fetch(lang, 'text')
  user_prompt = "Review the following #{lang.to_s.capitalize} #{payload_type}:\n\n```#{fence}\n#{input_payload}\n```"

  uri = URI.parse('https://api.openai.com/v1/chat/completions')
  http = Net::HTTP.new(uri.host, uri.port)
  http.use_ssl = true
  http.read_timeout = 300
  req = Net::HTTP::Post.new(uri.request_uri, { 'Content-Type' => 'application/json', 'Authorization' => "Bearer #{api_key}" })
  req.body = { model: model, reasoning_effort: reasoning_effort,
               messages: [{ role: 'developer', content: dev_prompt }, { role: 'user', content: user_prompt }] }.to_json

  resp = execute_api_post_with_retry(http, req)
  if resp&.is_a?(Net::HTTPSuccess)
    puts JSON.parse(resp.body).dig('choices', 0, 'message', 'content')
  else
    abort resp ? "API Error (#{resp.code}): #{resp.body}" : 'Network error contacting OpenAI API'
  end
end

def audit_via_gemini(dev_prompt, input_payload, payload_type, profile_key, _model, _tier, lang)
  warn "Auditing via Gemini Flash (bws run) [Profile: #{profile_key}]..."
  fence = { go: 'go', rust: 'rust', ruby: 'ruby' }.fetch(lang, 'text')
  ext = { go: '.go', rust: '.rs', ruby: '.rb' }.fetch(lang, '.txt')
  temp_payload = nil

  prompt = if input_payload.bytesize > 32_000
             tname = ".audit_payload_#{Process.pid}_#{Time.now.to_i}#{ext}"
             temp_payload = File.join(Dir.pwd, tname)
             File.write(temp_payload, input_payload)
             "#{dev_prompt}\n\nReview #{lang.to_s.capitalize} in #{tname} (contains source files with `// FILE:` headers). Cite original file paths in findings, not #{tname}."
           else
             "#{dev_prompt}\n\nReview the following #{lang.to_s.capitalize} #{payload_type}:\n\n```#{fence}\n#{input_payload}\n```"
           end

  cmd = ['bws', 'run', '--', 'agy-run-wild', '-p', prompt]
  stdout, stderr, status = Open3.capture3(*cmd)
  if status.success?
    puts stdout.lines.reject { |l| l =~ /Successfully trusted workspace/ }.join
  else
    warn stderr unless stderr.strip.empty?
    exit status.exitstatus || 1
  end
ensure
  FileUtils.rm_f(temp_payload) if temp_payload
end

def main
  opts = parse_cli_options
  lang = detect_project_language
  profile_key, profile_info = resolve_profile(opts[:profile], lang)
  backend = resolve_backend(opts[:backend], opts[:tier], profile_key)
  model = resolve_model(backend, opts[:tier], opts[:model])

  payload_type, input_payload = collect_payload(
    opts[:target] || [],
    profile_key: profile_key,
    backend: backend,
    all_files: opts[:all_files],
    include_tests: opts[:include_tests],
    lang: lang
  )

  if input_payload.nil? || input_payload.strip.empty?
    puts 'NO CRITICAL DEFECTS FOUND (No input received).'
    exit 0
  end

  dev_prompt = developer_prompt(profile_key, profile_info, lang)
  case backend
  when :gemini     then audit_via_gemini(dev_prompt, input_payload, payload_type, profile_key, model, opts[:tier], lang)
  when :claude     then audit_via_claude(dev_prompt, input_payload, payload_type, profile_key, model, opts[:tier], lang)
  when :codex      then audit_via_codex(dev_prompt, input_payload, payload_type, profile_key, model, opts[:tier], lang)
  when :openai_api then audit_via_api(ENV['OPENAI_API_KEY'], dev_prompt, input_payload, payload_type, profile_key, model, opts[:tier], lang)
  end
end

main if __FILE__ == $PROGRAM_NAME
