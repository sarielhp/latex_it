def detect_project_language(dir = REPO_ROOT)
  pname = File.basename(dir)
  if Dir.exist?(File.join(dir, 'lib', pname)) || File.exist?(File.join(dir, pname))
    :ruby
  elsif File.exist?(File.join(dir, 'Gemfile')) || File.exist?(File.join(dir, '.rubocop.yml'))
    :ruby
  elsif File.exist?(File.join(dir, 'go.mod'))
    :go
  elsif File.exist?(File.join(dir, 'Cargo.toml'))
    :rust
  elsif Dir.glob(File.join(dir, '**', '*.rb')).any?
    :ruby
  elsif Dir.glob(File.join(dir, '**', '*.go')).any?
    :go
  elsif Dir.glob(File.join(dir, '**', '*.rs')).any?
    :rust
  else
    :generic
  end
end

