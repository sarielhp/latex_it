#!/usr/bin/env ruby
# frozen_string_literal: true

# Tiered quality gate. The default is cheap enough to run after every edit.
require 'open3'
require 'optparse'
require 'etc'

module QualityGate
  COLORS = { green: "\e[32m", red: "\e[31m", cyan: "\e[36m", bold: "\e[1m", reset: "\e[0m" }.freeze
  FAST_TESTS = %w[
    test_arxiv_cycle.rb test_arxiv_runner_review.rb test_arxiv_worker.rb
    test_author_verification.rb test_code_metrics.rb test_compatibility.rb
    test_repair_failures.rb test_sample_arxiv.rb test_sample_arxiv_review.rb
  ].freeze
  MEDIUM_TESTS = %w[
    test_arxiv.rb test_latex_it.rb test_metadata_report_review.rb
  ].freeze
  FULL_TESTS = %w[
    test_arxiv_fixups.rb test_bws_review.rb test_visual_verification.rb
    test_review_integration.rb
  ].freeze
  TIERS = { fast: FAST_TESTS, medium: FAST_TESTS + MEDIUM_TESTS,
            full: FAST_TESTS + MEDIUM_TESTS + FULL_TESTS }.freeze

  def self.run!(tier)
    started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    root = File.expand_path('..', __dir__)
    Dir.chdir(root) do
      announce(tier)
      check_syntax!
      run_tests!(TIERS.fetch(tier))
    end
    elapsed = (Process.clock_gettime(Process::CLOCK_MONOTONIC) - started).round(2)
    puts color(:green, "#{color(:bold, 'All')} #{tier} quality gate checks passed in #{elapsed}s!")
  rescue KeyError
    abort 'gate: unknown tier'
  end

  def self.announce(tier)
    puts color(:bold, "==> Running #{tier.capitalize} Quality Gate (latex_it)...")
  end

  def self.check_syntax!
    puts "--> #{color(:cyan, '[1/2]')} Ruby syntax verification (ruby -cw)..."
    files = ['latex_it'] + Dir.glob('lib/**/*.rb') + Dir.glob('tools/*').select { |path| ruby_script?(path) } + Dir.glob('test/**/*.rb')
    files.uniq.each do |file|
      output, status = Open3.capture2e('ruby', '-cw', file)
      next if status.success?

      abort_failure("Syntax check failed on #{file}", output)
    end
  end

  def self.run_tests!(files)
    puts "--> #{color(:cyan, '[2/2]')} #{files.length} test files..."
    queue = Queue.new
    files.each { |name| queue << name }
    failures = []
    mutex = Mutex.new
    max_workers = (Etc.nprocessors rescue 4)
    worker_count = [max_workers, files.length, 4].min
    threads = worker_count.times.map do
      Thread.new do
        while (name = (queue.pop(true) rescue nil))
          file = File.join('test', name)
          output, status = run_test(file)
          mutex.synchronize { failures << [file, output] } unless status.success?
        end
      end
    end
    threads.each(&:join)
    return if failures.empty?

    failures.each { |file, output| warn color(:red, "❌ Test failure in #{file}:\n") + output }
    exit 1
  end

  def self.run_test(file)
    Open3.capture2e('ruby', '-I.', file)
  end

  def self.ruby_script?(path)
    File.file?(path) && (File.extname(path) == '.rb' || File.open(path, &:gets).to_s.start_with?('#!/usr/bin/env ruby'))
  end

  def self.abort_failure(label, output)
    warn color(:red, "❌ #{label}:")
    warn output
    exit 1
  end

  def self.color(name, text)
    "#{COLORS.fetch(name)}#{text}#{COLORS[:reset]}"
  end
end

options = { tier: :fast }
OptionParser.new do |opts|
  opts.banner = 'Usage: tools/gate [--fast|--medium|--full]'
  opts.on('--fast', 'syntax and deterministic unit tests (default)') { options[:tier] = :fast }
  opts.on('--medium', 'fast checks plus practical real-LaTeX integration tests') { options[:tier] = :medium }
  opts.on('--full', 'medium checks plus long integration, BWS, visual, and corpus checks') { options[:tier] = :full }
  opts.on('-h', '--help', 'show this help') { puts opts; exit }
end.parse!
abort "gate: unexpected arguments: #{ARGV.join(' ')}" unless ARGV.empty?
QualityGate.run!(options[:tier])
