    log_write("#{msg}\n")
    cmd = resolve_audit_cmd(profile, model_step)
    log_write("--> Audit command: #{cmd.join(' ')}\n")

    output, status = run_audit_process(cmd)
    log_write("--> Audit process exit status: #{status&.exitstatus}\n")

    unless status&.success?
      err_msg = "\n❌ Audit failed with exit code #{status&.exitstatus || 'unknown'}. Aborting cycle."
      puts err_msg.bold.red
      log_write("#{err_msg}\n")
      exit(status&.exitstatus || 1)
    end

    findings = count_audit_findings(output)
    log_write("--> Findings detected: #{findings}\n")
    [findings, output]
  end

