  def transient_error?(output, exit_status)
    return true if exit_status == 429 || exit_status == 503

    output.match?(/429|rate\s*limit|overloaded|502|503|504|timeout|connection\s*reset|network\s*error/i)
  end

  def execute_audit_attempt(cmd)
    output = String.new
    status = nil
    Open3.popen2e(*cmd) do |stdin, stdout_err, wait_thr|
      stdin.close rescue nil
      while (line = stdout_err.gets)
        print line
        output << line
        log_write(line)
      end
      status = wait_thr.value
    end
    [output, status]
  end

  def run_audit_process(cmd, max_retries = 3)
    attempt = 0
    loop do
      attempt += 1
      output, status = execute_audit_attempt(cmd)
      return [output, status] if status&.success?
      return [output, status] if attempt >= max_retries || !transient_error?(output, status&.exitstatus)

      delay = (2**attempt) + rand(0.5..1.5)
      warn_msg = "\n⚠️ Transient audit failure (attempt #{attempt}/#{max_retries}). Retrying in #{delay.round(1)}s..."
      puts warn_msg.bold.yellow
      log_write("#{warn_msg}\n")
      sleep delay
    end
  end

  def count_audit_findings(output)
    findings = output.scan(/\[SEVERITY\]/i).size
    if findings.zero? && output =~ /no\s+defects|0\s+defects|clean/i
      0
    elsif findings.zero? && output =~ /^\s*\d+\.\s*\[SEVERITY\]/i
      output.scan(/^\s*\d+\.\s*\[SEVERITY\]/i).size
    else
      findings
    end
  end

  def run_audit(profile, model_step)
    msg = "\n==> [Phase 1/5] Running Adversarial Audit [Lens: #{profile}, Model: #{model_step[:label]}]..."
