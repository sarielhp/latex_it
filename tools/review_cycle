class MultiProfileReviewCycle
  attr_reader :options, :state

  def initialize(options)
    config = load_config_file(options[:config])
    # CLI options take precedence over config file, which takes precedence over defaults
    @options = config.merge(options.reject { |_k, v| v.nil? })
    @state = load_state
  end

  def load_config_file(explicit_path = nil)
    if explicit_path
      unless File.file?(explicit_path)
        warn "⚠️ Config file not found: #{explicit_path}".yellow
        return {}
      end
      return parse_config_file(explicit_path)
    end

    cfg_path = self.class.default_config_paths.find { |p| File.file?(p) }
    cfg_path ? parse_config_file(cfg_path) : {}
  end

  def parse_config_file(path)
    parsed = JSON.parse(File.read(path))
    parsed.transform_keys(&:to_sym)
  rescue StandardError => e
    warn "⚠️ Failed to parse config file #{path}: #{e.message}".yellow
    {}
  end

  def run
    puts "==> review_cycle v#{VERSION}".bold.cyan
    Dir.chdir(REPO_ROOT) do
      cycle_count = 0
      clean_profiles = Set.new

      loop do
        cycle_count += 1
        active_profile, p_cand_idx = peek_profile
        model_step, c_cand_idx = peek_model_step

        review_num = next_review_number
        init_cycle_log(review_num, active_profile, model_step)
        print_cycle_header(cycle_count, active_profile, model_step)
        preflight_check

        puts "\n==> Target Review Artifact: #{reports_dir}/#{review_num}_#{active_profile}.md".bold.yellow

        begin
          findings, review_content = run_audit(active_profile, model_step)
          advance_state(p_cand_idx, c_cand_idx)

          if findings.zero?
            clean_profiles << active_profile
            handle_clean_audit(review_num, active_profile, model_step, review_content: review_content)
            break if loop_converged?(clean_profiles, active_profile)
          else
            clean_profiles.clear
            proceed = handle_defect_audit(review_num, active_profile, model_step, findings, review_content)
            break unless proceed
          end
        ensure
          close_cycle_log
        end

        break unless options[:loop]
        break if cycle_limit_reached?(cycle_count)
      end

      print_loop_summary(cycle_count, clean_profiles) if options[:loop] && cycle_count > 1
    end
  end

  def print_cycle_header(cycle_count, active_profile, model_step)
    puts "\n" + ('=' * 74).cyan
    puts " 🚀 Starting Review Cycle #{cycle_count} [Lens: #{active_profile.upcase}, #{model_step[:label]}]".bold.cyan
    puts ('=' * 74).cyan
  end

  def handle_clean_audit(review_num, active_profile, model_step, review_content: nil)
    puts "\n🎉 Profile [#{active_profile}] reported 0 defects! Clean bill of health.".bold.green
    record_history(review_num, active_profile, model_step, 0, 'clean', files_edited: 0)
    commit_and_push_cycle(review_num, active_profile, clean: true)
    print_bottom_summary(
      num: review_num, profile: active_profile, model_step: model_step,
      findings: 0, review_content: review_content, footprint: nil, outcome: 'clean'
    )
  end

  def loop_converged?(clean_profiles, active_profile)
    return false unless options[:loop]

    if %w[auto random].include?(options[:profile]) && clean_profiles.size >= AUDIT_PROFILES.size
      puts "\n🌟 COMPLETE CONVERGENCE: All #{AUDIT_PROFILES.size} audit profiles passed with 0 defects!".bold.green
      true
    elsif !%w[auto random].include?(options[:profile]) && clean_profiles.include?(active_profile)
      puts "\n🌟 Profile [#{active_profile}] verified clean with 0 defects!".bold.green
      true
    else
      false
    end
  end

  def cycle_limit_reached?(cycle_count)
    if cycle_count >= options[:max_cycles]
      puts "\nReached maximum cycle count (#{options[:max_cycles]}). Halting loop.".yellow
      true
    else
      false
    end
  end

  def handle_defect_audit(review_num, active_profile, model_step, findings, review_content)
    puts "\n==> Found #{findings} defect(s). Generating #{reports_dir}/#{review_num}_#{active_profile}.md...".yellow
    save_review_report(review_num, active_profile, model_step, review_content)

    if options[:dry_run]
      puts 'Dry-run enabled. Skipping sandbox remediation.'.yellow
      print_bottom_summary(
        num: review_num, profile: active_profile, model_step: model_step,
        findings: findings, review_content: review_content, footprint: nil, outcome: 'dry_run'
      )
      return false
    end

    base_sha = `git rev-parse HEAD`.strip

    unless remediate_in_sandbox(review_num, active_profile)
      rollback_workspace(base_sha, 'Sandbox remediation failed or was discarded')
      record_history(review_num, active_profile, model_step, findings, 'failed_sandbox', files_edited: 0)
      print_bottom_summary(
        num: review_num, profile: active_profile, model_step: model_step,
        findings: findings, review_content: review_content, footprint: nil, outcome: 'failed_sandbox'
      )
      return options[:loop]
    end

    footprint = check_diff_footprint(base_sha)
    if footprint[:aborted]
      rollback_workspace(base_sha, footprint[:reason])
      record_history(review_num, active_profile, model_step, findings, 'rejected_diff', files_edited: 0)
      print_bottom_summary(
        num: review_num, profile: active_profile, model_step: model_step,
        findings: findings, review_content: review_content, footprint: nil, outcome: 'rejected_diff'
      )
      return options[:loop]
    end

    unless verify_quality_gate
      rollback_workspace(base_sha, 'Post-merge quality gate verification failed')
      record_history(review_num, active_profile, model_step, findings, 'failed_gate', files_edited: 0)
      print_bottom_summary(
        num: review_num, profile: active_profile, model_step: model_step,
        findings: findings, review_content: review_content, footprint: nil, outcome: 'failed_gate'
      )
      return options[:loop]
    end

    reinstall_binary
    diff_audit = run_differential_audit(active_profile, base_sha) unless options[:skip_diff_audit]
    summary_content = generate_post_work_summary(review_num, active_profile, model_step, findings,
                                                  footprint: footprint, diff_audit: diff_audit)
    output_summary(review_num, summary_content)
    archive_artifacts(review_num) unless options[:keep_reviews]
    record_history(review_num, active_profile, model_step, findings, 'remediated',
                   files_edited: footprint[:files]&.size)
    commit_and_push_cycle(review_num, active_profile)

    puts "\n✅ Review Cycle #{review_num} (#{active_profile}) completed and archived!".bold.green
    print_bottom_summary(
      num: review_num, profile: active_profile, model_step: model_step,
      findings: findings, review_content: review_content, footprint: footprint, outcome: 'remediated'
    )
    true
  end

  def init_cycle_log(num, profile, model_step)
    ldir = logs_dir
    FileUtils.mkdir_p(ldir)
    @current_log_path = File.join(ldir, "review_#{num}_#{profile}.log")
    @log_file&.close rescue nil
    @log_file = File.open(@current_log_path, 'a')
    @log_file.sync = true

    latest_path = File.join(ldir, 'latest.log')
    File.delete(latest_path) if File.exist?(latest_path) || File.symlink?(latest_path)
    File.symlink(@current_log_path, latest_path) rescue nil

    log_write("=== Review Cycle #{num} [Lens: #{profile}, Model: #{model_step[:label]}] Started at #{Time.now.utc.iso8601} ===\n")
    puts "==> Execution Log: #{@current_log_path}".cyan
  end

  def log_write(str)
    return unless @log_file

    clean_str = str.gsub(/\e\[[0-9;]*[mK]/, '')
    @log_file.write(clean_str)
  end

  def close_cycle_log
    return unless @log_file

    log_write("=== Review Cycle Log Finished at #{Time.now.utc.iso8601} ===\n\n")
    @log_file.close rescue nil
    @log_file = nil
  end

  def rollback_workspace(base_sha, reason)
    msg = "\n⚠️ [Rollback] #{reason}. Reverting workspace to #{base_sha[0..8]}..."
    puts msg.bold.red
    log_write("#{msg}\n")
    system('git', 'reset', '--hard', base_sha)
    system('git', 'clean', '-fd')
    done_msg = "Workspace rolled back cleanly to #{base_sha[0..8]}."
    puts done_msg.yellow
    log_write("#{done_msg}\n")
  end

  # Language & Framework Helpers
  def detect_project_language
    pname = File.basename(REPO_ROOT)
    if Dir.exist?(File.join(REPO_ROOT, 'lib', pname)) || File.exist?(File.join(REPO_ROOT, pname))
      :ruby
    elsif File.exist?(File.join(REPO_ROOT, 'Gemfile'))
      :ruby
    elsif File.exist?(File.join(REPO_ROOT, 'go.mod'))
      :go
    elsif File.exist?(File.join(REPO_ROOT, 'Cargo.toml'))
      :rust
    elsif Dir.glob(File.join(REPO_ROOT, '**', '*.rb')).any?
      :ruby
    elsif Dir.glob(File.join(REPO_ROOT, '**', '*.go')).any?
      :go
    elsif Dir.glob(File.join(REPO_ROOT, '**', '*.rs')).any?
      :rust
    else
      :generic
    end
  end

  def target_directory
    return options[:target] if options[:target] && !options[:target].strip.empty?
    return ENV['AUDIT_TARGET'] if ENV['AUDIT_TARGET'] && !ENV['AUDIT_TARGET'].strip.empty?

    lang = detect_project_language
    if lang == :rust && Dir.exist?(File.join(REPO_ROOT, 'src'))
      'src/'
    elsif lang == :ruby && Dir.exist?(File.join(REPO_ROOT, 'lib'))
      pname = File.basename(REPO_ROOT)
      bin_file = [File.join(REPO_ROOT, pname), File.join(REPO_ROOT, 'bin', pname), File.join(REPO_ROOT, 'exe', pname)].find { |f| File.file?(f) }
      bin_file ? "lib #{bin_file.sub(%r{^#{Regexp.escape(REPO_ROOT)}/}, '')}" : 'lib/'
    else
      '.'
    end
  end

  def reports_dir
    @reports_dir ||= begin
      if options[:reports_dir] && !options[:reports_dir].strip.empty?
        options[:reports_dir]
      elsif Dir.exist?(File.join(REPO_ROOT, 'reviews'))
        'reviews'
      elsif Dir.exist?(File.join(REPO_ROOT, 'reports'))
        'reports'
      else
        'reviews'
      end
    end
  end

  def logs_dir
    File.join(REPO_ROOT, reports_dir, 'logs')
  end

  def archive_dir
    File.join(REPO_ROOT, reports_dir, 'archive')
  end

  def guideline_instructions
    hints = []
    hints << options[:guidelines] if options[:guidelines] && !options[:guidelines].strip.empty?

    agents_file = File.join(REPO_ROOT, 'AGENTS.md')
    claude_file = File.join(REPO_ROOT, 'CLAUDE.md')
    audit_code_file = [File.join(REPO_ROOT, 'tools', 'gate_audit_code'), File.join(REPO_ROOT, 'tools', 'audit_code')].find { |f| File.exist?(f) }

    if File.exist?(agents_file)
      content = File.read(agents_file)
      hints << (content.include?('80 lines') ? 'Adhere strictly to AGENTS.md (<= 80 lines per function, decompose in place)' : 'Adhere strictly to all guidelines in AGENTS.md')
    elsif File.exist?(claude_file)
      hints << 'Adhere strictly to all guidelines in CLAUDE.md'
    end

    if audit_code_file && !options[:guidelines]
      tool_name = File.basename(audit_code_file)
      hints << "Adhere strictly to tools/#{tool_name} (method length <= 80 lines, cognitive complexity <= 15, depth <= 4)"
    end

    hints.empty? ? '' : " #{hints.join('. ')}."
  end

  def candidate_gate_commands
    [
      File.expand_path('gate', __dir__),
      File.expand_path('check', __dir__),
      File.expand_path('check.rb', __dir__)
    ]
  end

  def language_gate_command
    case detect_project_language
    when :rust then File.exist?(File.join(REPO_ROOT, 'Cargo.toml')) ? 'cargo test' : nil
    when :go   then File.exist?(File.join(REPO_ROOT, 'go.mod')) ? 'go test ./...' : nil
    when :ruby then Dir.exist?(File.join(REPO_ROOT, 'test')) ? 'ruby -I. test/test_*.rb' : nil
    end
  end

  def resolve_gate_cmd
    return options[:gate_cmd] if options[:gate_cmd] && !options[:gate_cmd].strip.empty?
    return ENV['GATE_CMD'] if ENV['GATE_CMD'] && !ENV['GATE_CMD'].strip.empty?

    candidate = candidate_gate_commands.find { |p| File.file?(p) && (File.executable?(p) || p.end_with?('.rb')) }
    return candidate.end_with?('.rb') && !File.executable?(candidate) ? "ruby #{candidate}" : candidate if candidate

    makefile = File.join(REPO_ROOT, 'Makefile')
    return 'make check' if File.file?(makefile) && File.read(makefile).match?(/^\s*check\s*:/)

    language_gate_command
  end

  def resolve_audit_executable
    return options[:audit_cmd] if options[:audit_cmd] && !options[:audit_cmd].strip.empty?
    return ENV['AUDIT_CMD'] if ENV['AUDIT_CMD'] && !ENV['AUDIT_CMD'].strip.empty?

    tools_audit = File.expand_path('audit', __dir__)
    return tools_audit if File.exist?(tools_audit) && (File.executable?(tools_audit) || !File.directory?(tools_audit))

    tools_audit_rb = File.expand_path('audit.rb', __dir__)
    return "ruby #{tools_audit_rb}" if File.exist?(tools_audit_rb)

    root_audit = File.join(REPO_ROOT, 'audit')
    return root_audit if File.exist?(root_audit) && (File.executable?(root_audit) || !File.directory?(root_audit))

    path_audit = `which audit 2>/dev/null`.strip
    return path_audit unless path_audit.empty?

    path_agy = `which agy_audit 2>/dev/null`.strip
    return path_agy unless path_agy.empty?

    nil
  end

  def safe_install_script?(path)
    return false unless File.file?(path) && (File.executable?(path) || path.end_with?('.rb'))

    content = File.read(path) rescue ''
    !content.include?('git commit') && !content.include?('git push')
  end

  def language_build_command
    case detect_project_language
    when :rust then File.exist?(File.join(REPO_ROOT, 'Cargo.toml')) ? 'cargo build --release' : nil
    when :go   then File.exist?(File.join(REPO_ROOT, 'go.mod')) ? 'go build .' : nil
    end
  end

  def resolve_build_cmd
    return options[:build_cmd] if options[:build_cmd] && !options[:build_cmd].strip.empty?
    return ENV['BUILD_CMD'] if ENV['BUILD_CMD'] && !ENV['BUILD_CMD'].strip.empty?

    bl_bin = File.expand_path('build_local', __dir__)
    return bl_bin if File.file?(bl_bin) && File.executable?(bl_bin)

    bl_rb = File.expand_path('build_local.rb', __dir__)
    return "ruby #{bl_rb}" if File.file?(bl_rb)

    makefile = File.join(REPO_ROOT, 'Makefile')
    return 'make build' if File.file?(makefile) && File.read(makefile).match?(/^\s*build\s*:/)

    inst = File.expand_path('install', __dir__)
    return inst if safe_install_script?(inst)

    language_build_command
  end

  private

  def state_file_path
    @state_file_path ||= self.class.state_file_path(reports_dir)
  end

  def load_state
    target = state_file_path
    if File.exist?(target)
      JSON.parse(File.read(target))
    else
      migrate_or_init_state(target)
    end
  rescue StandardError
    default_empty_state
  end

  def migrate_or_init_state(target)
    legacy = [File.join(REPO_ROOT, '.review_state.json'), File.join(REPO_ROOT, 'review_state.json')].find { |f| File.exist?(f) }
    if legacy
      data = JSON.parse(File.read(legacy)) rescue nil
      if data
        FileUtils.mkdir_p(File.dirname(target))
        File.write(target, JSON.pretty_generate(data))
        FileUtils.rm_f(legacy)
        return data
      end
    end
    default_empty_state
  end

  def default_empty_state
    { 'last_profile_index' => -1, 'last_cadence_index' => -1, 'history' => [] }
  end

  def save_state
    FileUtils.mkdir_p(File.dirname(state_file_path))
    File.write(state_file_path, JSON.pretty_generate(@state))
  end

  def peek_profile
    case options[:profile]
    when 'random'
      chosen = AUDIT_PROFILES.sample
      puts "Profile selected randomly: #{chosen}".magenta
      [chosen, nil]
    when 'auto'
      next_idx = ((state['last_profile_index'] || -1) + 1) % AUDIT_PROFILES.size
      chosen = AUDIT_PROFILES[next_idx]
      puts "Profile candidate via Round-Robin: #{chosen} (profile #{next_idx + 1}/#{AUDIT_PROFILES.size})".magenta
      [chosen, next_idx]
    else
      prof = AUDIT_PROFILES.include?(options[:profile]) ? options[:profile] : 'systems'
      [prof, nil]
    end
  end

  def peek_model_step
    if options[:backend] || options[:tier]
      backend = options[:backend] || 'auto'
      tier = options[:tier] || 'standard'
      label = "Manual Override (#{backend.upcase}/#{tier.upcase})"
      puts "Model selection overridden: #{label}".magenta
      return [{ tier: tier, backend: backend, label: label }, nil]
    end

    next_idx = ((state['last_cadence_index'] || -1) + 1) % MODEL_CADENCE.size
